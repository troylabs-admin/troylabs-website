// node --experimental-strip-types qa/portal/recurrence-unit.mts
import assert from 'node:assert/strict';
import { cleanRecurrence, localToInstant, recurrenceStart, planRecurrence, describeRecurrence, type Recurrence } from '../../supabase/functions/_shared/recurrence.ts';
const rule = (start_local: string, extra: Partial<Recurrence> = {}): Recurrence => ({ frequency: 'daily', interval: 1, timezone: 'America/Los_Angeles', start_local, end: { type: 'never' }, ...extra });
const next = (r: Recurrence) => planRecurrence(r, recurrenceStart(r), recurrenceStart(r)).next_at;
assert.equal(next(rule('2026-03-07T10:00')), '2026-03-08T17:00:00.000Z', 'spring DST keeps local hour');
assert.equal(next(rule('2026-10-31T10:00')), '2026-11-01T18:00:00.000Z', 'fall DST keeps local hour');
assert.equal(localToInstant('2026-11-01T01:30', 'America/Los_Angeles'), '2026-11-01T08:30:00.000Z', 'fold uses first instant');
assert.equal(localToInstant('2026-03-08T02:30', 'America/Los_Angeles'), '2026-03-08T10:30:00.000Z', 'gap uses pretransition offset (RFC erratum 4271)');
assert.equal(localToInstant('2026-04-05T01:45', 'Australia/Lord_Howe'), '2026-04-04T14:45:00.000Z', 'half-hour fold');
assert.equal(next(rule('2026-01-31T10:00', { frequency: 'monthly' })), '2026-03-31T17:00:00.000Z', 'month end skips invalid day, no drift');
assert.equal(next(rule('2024-02-29T10:00', { frequency: 'yearly' })), '2028-02-29T18:00:00.000Z', 'leap-year anchoring');
assert.equal(next(rule('2096-02-29T10:00', { frequency: 'yearly' })), '2104-02-29T18:00:00.000Z', 'Gregorian century leap exception');
assert.equal(next(rule('2026-01-30T10:00', { frequency: 'monthly', interval: 2 })), '2026-03-30T17:00:00.000Z');
assert.equal(next(rule('2026-10-06T10:00', { frequency: 'weekly', interval: 2, weekdays: [1, 3, 5] })), '2026-10-07T17:00:00.000Z');
const weekly = rule('2026-10-06T10:00', { frequency: 'weekly', interval: 2, weekdays: [1, 3, 5] });
assert.deepEqual(planRecurrence(weekly, recurrenceStart(weekly), '2026-10-09T17:00:00Z'), { occurrence_at: '2026-10-09T17:00:00.000Z', next_at: '2026-10-19T17:00:00.000Z', next_index: 3, skipped: 2 });
const counted = rule('2026-10-06T10:00', { end: { type: 'count', count: 3 } });
assert.deepEqual(planRecurrence(counted, recurrenceStart(counted), '2026-11-01T20:00:00Z'), { occurrence_at: '2026-10-08T17:00:00.000Z', next_at: null, next_index: 3, skipped: 2 }, 'count includes elapsed slots; only latest due emitted');
assert.equal(next(rule('2026-10-06T10:00', { end: { type: 'count', count: 1 } })), null);
const until = rule('2026-10-06T10:00', { end: { type: 'until', until: '2026-10-07' } });
assert.equal(planRecurrence(until, recurrenceStart(until), '2026-10-07T17:00:00Z').occurrence_at, '2026-10-07T17:00:00.000Z');
assert.equal(planRecurrence(until, recurrenceStart(until), '2026-10-07T17:00:00Z').next_at, null, 'inclusive local date ending');
const daily = rule('2026-10-06T10:00');
const first = planRecurrence(daily, recurrenceStart(daily), '2026-10-06T17:05:00Z');
assert.deepEqual(planRecurrence(daily, first.next_at!, '2026-10-10T17:05:00Z', first.next_index), { occurrence_at: '2026-10-10T17:00:00.000Z', next_at: '2026-10-11T17:00:00.000Z', next_index: 5, skipped: 3 });
assert.throws(() => planRecurrence(daily, '2026-10-06T18:00:00Z', '2026-10-06T19:00:00Z'), /does not match/);
assert.throws(() => planRecurrence(daily, recurrenceStart(daily), '2026-10-06T17:00:00Z', -1));
for (const patch of [{ interval: 0 }, { interval: 1.5 }, { interval: 1000 }, { frequency: 'hourly' }, { timezone: 'Mars/Base' }, { start_local: '2026-02-30T10:00' }, { end: { type: 'count', count: 0 } }, { end: { type: 'until', until: '2026-01-01' } }, { frequency: 'weekly', weekdays: [] }, { frequency: 'weekly', weekdays: [7] }]) assert.throws(() => cleanRecurrence({ ...daily, ...patch }));
assert.equal(cleanRecurrence(null), null);
assert.match(describeRecurrence(weekly), /Every 2 weeks on Mon, Wed, Fri/);
console.log('PASS: anchored daily/weekly/monthly/yearly, intervals, weekdays, inclusive until/count, downtime coalescing, cursor validation, DST fold/gap/half-hour, month-end and leap-year rules');
