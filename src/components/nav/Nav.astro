---
/**
 * Site navigation — Figma component "Nav" (7033:2233), 1001×79 du.
 * Rocket mark @30,20 26×39 · links HOME/BUILD/IGNITE/DEMO starting at x=299 (50du gaps; HOME
 * added 2026-08-24 so the top nav matches the footer — the rocket stays the mark, not the only way home)
 * · Apply right-aligned (ends at x=976).
 */
import { pos, u } from '../../lib/units';
import rocket from '../../assets/figma/nav-rocket.svg?raw';
import ApplyLink from '../ui/ApplyLink.astro';

/* The alumni portal reuses this nav with its own links (Bryan, 2026-09-14): signed in, the row is
   SEARCH · PROFILE · ADMIN with SIGN OUT in the Apply slot — one nav, not two stacked. On the
   public sign-in page the site links stay and the slot reads ALUMNI NETWORK instead of pitching applications. */
interface Props { current?: string; variant?: 'site' | 'portal' | 'gate'; admin?: boolean }
const { current, variant = 'site', admin = true } = Astro.props;

const siteLinks = [
  { href: '/', label: 'HOME', key: 'home' },
  { href: '/build', label: 'BUILD', key: 'build' },
  { href: '/ignite', label: 'IGNITE', key: 'ignite' },
  { href: '/demo', label: 'DEMO', key: 'demo' },
];
const portalLinks = [
  { href: '/alumni-portal/home', label: 'SEARCH', key: 'home' },
  { href: '/alumni-portal/profile', label: 'PROFILE', key: 'profile' },
  ...(admin ? [{ href: '/alumni-portal/admin', label: 'ADMIN', key: 'admin' }] : []),
];
const links = variant === 'portal' ? portalLinks : siteLinks;
/* signed in: the slot names the person, so every page knows who you are (design preview: placeholder) */
const slot = variant === 'portal' ? { href: '/alumni-portal', label: 'SIGN OUT' }
           : variant === 'gate' ? { href: '/alumni-portal', label: 'ALUMNI NETWORK' }
           : null;
---

<header class="section z-10" style="--h:79" data-figma="Nav">
  <a href="/" class="abs" style={`${pos(30, 20, 26, 39)};--i:0`} aria-label="TroyLabs home" set:html={rocket} />

  <nav class="abs flex" style={`${pos(0, 32)};left:50%;transform:translateX(-50%);gap:${u(50)}`} aria-label="Primary">
    {links.map((l, i) => (
      <a href={l.href} class="t-nav glow-text whitespace-nowrap" style={`--i:${i + 1}`} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>

  {variant === 'portal' && <a href="/alumni-portal/profile" class="abs t-nav text-muted whitespace-nowrap no-underline nav-who" style={`${pos(700, 32, 130, 14)};--i:4;text-align:right`} title="Your profile">SAMPLE ALUM</a>}
  {slot ? <ApplyLink class="abs" style={`${pos(836, 32, 140, 14)};--i:5`} href={slot.href} label={slot.label} /> : <ApplyLink class="abs" style={`${pos(836, 32, 140, 14)};--i:5`} />}
</header>

<!-- mobile: one tight row -->
<header class:list={["m m-nav", variant === "portal" && "m-nav-portal"]} data-m="Nav">
  <a href="/" class="m-mark" aria-label="TroyLabs home" set:html={rocket} />
  <nav class="m-links" aria-label="Primary">
    {links.map((l) => (
      <a href={l.href} class="t-nav glow-text whitespace-nowrap" aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  {slot ? <ApplyLink class="m-apply t-nav" href={slot.href} label={variant === 'gate' ? 'ALUMNI' : slot.label} /> : <ApplyLink class="m-apply t-nav" label="APPLY" />}
</header>

<style>
  header :global(svg) { width: 100%; height: 100%; }
  .nav-who { transition: color 150ms ease; }
  .nav-who:hover { color: var(--color-ink); }
  .m-nav { display: none; }
  @media (max-width: 767px) {
    .m-nav { display: flex; align-items: center; gap: 14px; padding: 16px 18px 12px; }
    /* portal variant: SEARCH · PROFILE · ADMIN + SIGN OUT — tighter type so the row fits a 390px phone */
    .m-nav-portal { gap: 8px; padding-inline: 14px; }
    .m-nav-portal .m-links { gap: 8px; flex: 1; min-width: 0; justify-content: space-between; }
    /* type sizes for this variant live in styles/mobile.css: SIGN OUT is rendered by the ApplyLink child, which
       this scoped block cannot reach (Astro scoping stops at component boundaries) */
    .m-mark { width: 17px; height: 26px; flex: none; }
    .m-links { display: flex; gap: 13px; flex: 1; justify-content: center; }
    .m-apply { flex: none; }
  }
</style>
