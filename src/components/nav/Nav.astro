---
/**
 * Site navigation — Figma component "Nav" (7033:2233), 1001×79 du.
 * Rocket mark @30,20 26×39 · links HOME/BUILD/IGNITE/DEMO starting at x=299 (50du gaps; HOME
 * added 2026-08-24 so the top nav matches the footer — the rocket stays the mark, not the only way home)
 * · Apply right-aligned (ends at x=976).
 */
import { pos, u } from '../../lib/units';
import rocket from '../../assets/figma/nav-rocket.svg?raw';
import ApplyLink from '../ui/ApplyLink.astro';

interface Props { current?: 'home' | 'build' | 'ignite' | 'demo' }
const { current } = Astro.props;

const links = [
  { href: '/', label: 'HOME', key: 'home' },
  { href: '/build', label: 'BUILD', key: 'build' },
  { href: '/ignite', label: 'IGNITE', key: 'ignite' },
  { href: '/demo', label: 'DEMO', key: 'demo' },
] as const;
---

<header class="section z-10" style="--h:79" data-figma="Nav">
  <a href="/" class="abs" style={`${pos(30, 20, 26, 39)};--i:0`} aria-label="TroyLabs home" set:html={rocket} />

  <nav class="abs flex" style={`${pos(0, 32)};left:50%;transform:translateX(-50%);gap:${u(50)}`} aria-label="Primary">
    {links.map((l, i) => (
      <a href={l.href} class="t-nav glow-text whitespace-nowrap" style={`--i:${i + 1}`} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>

  <ApplyLink class="abs" style={`${pos(836, 32, 140, 14)};--i:5`} />
</header>

<!-- mobile: one tight row -->
<header class="m m-nav" data-m="Nav">
  <a href="/" class="m-mark" aria-label="TroyLabs home" set:html={rocket} />
  <nav class="m-links" aria-label="Primary">
    {links.map((l) => (
      <a href={l.href} class="t-nav glow-text whitespace-nowrap" aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <ApplyLink class="m-apply t-nav" label="APPLY" />
</header>

<style>
  header :global(svg) { width: 100%; height: 100%; }
  .m-nav { display: none; }
  @media (max-width: 767px) {
    .m-nav { display: flex; align-items: center; gap: 14px; padding: 16px 18px 12px; }
    .m-mark { width: 17px; height: 26px; flex: none; }
    .m-links { display: flex; gap: 13px; flex: 1; justify-content: center; }
    .m-apply { flex: none; }
  }
</style>
