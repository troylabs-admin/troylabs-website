---
/**
 * Alumni portal › admin sections. Just the five sections as tabs — the site nav's ADMIN item already
 * lights orange while you are here (Nav.astro), and who you are is on Profile, so the badge and the
 * "signed in as" line came off (Bryan, 2026-09-16). Wraps on phones so the last tab is never clipped.
 */
interface Props { current: string }
const { current } = Astro.props;
const items = [
  { key: 'admin', label: 'OVERVIEW', href: '/alumni-portal/admin' },
  { key: 'users', label: 'MEMBERS', href: '/alumni-portal/admin/users' },
  { key: 'messages', label: 'MESSAGE', href: '/alumni-portal/admin/messages' },
  { key: 'analytics', label: 'ANALYTICS', href: '/alumni-portal/admin/analytics' },
  { key: 'handoff', label: 'TECH STACK', href: '/alumni-portal/admin/handoff' },
];
---
<nav class="portal-adminbar" aria-label="Admin">
  <ul class="m-0 p-0 list-none portal-admin-tabs t-label">
    {items.map((i) => <li><a href={i.href} class:list={['no-underline portal-admin-tab', i.key === current && 'is-current']} aria-current={i.key === current ? 'page' : undefined}>{i.label}</a></li>)}
  </ul>
</nav>
