---
/** Alumni portal › admin sub-nav (the MVP's admin layout): ADMIN · MESSAGES · USERS · ANALYTICS, BACK right. */
interface Props { current: string }
const { current } = Astro.props;
/* No BACK: "back to what?" — the portal nav one row up already has SEARCH (Bryan, 2026-09-14).
   DASHBOARD, not ADMIN: the row sits under an ADMIN nav item and above an ADMIN title; three ADMINs. */
const items = [
  { key: 'admin', label: 'DASHBOARD', href: '/alumni-portal/admin' },
  { key: 'users', label: 'USERS', href: '/alumni-portal/admin/users' },
  { key: 'messages', label: 'MESSAGES', href: '/alumni-portal/admin/messages' },
  { key: 'analytics', label: 'ANALYTICS', href: '/alumni-portal/admin/analytics' },
];
---
<nav class="portal-nav t-nav" aria-label="Admin">
  <ul class="m-0 p-0 list-none flex portal-nav-list">
    {items.map((i) => <li><a href={i.href} class:list={['no-underline glow-text', i.key === current ? 'text-ink' : 'text-muted']} aria-current={i.key === current ? 'page' : undefined}>{i.label}</a></li>)}
  </ul>
</nav>
