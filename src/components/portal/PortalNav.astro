---
/**
 * Alumni portal › navigation rows. `variant="portal"` is the signed-in nav (SEARCH · GLOBE · PROFILE ·
 * ADMIN, SIGN OUT right); `variant="admin"` mirrors the MVP's admin layout (ADMIN · MESSAGES · USERS ·
 * ANALYTICS, BACK right). Site nav type; current item solid, the rest muted.
 */
interface Props { current: string; admin?: boolean; variant?: 'portal' | 'admin' }
const { current, admin = false, variant = 'portal' } = Astro.props;
const items = variant === 'admin'
  ? [
      { key: 'admin', label: 'ADMIN', href: '/alumni-portal/admin' },
      { key: 'messages', label: 'MESSAGES', href: '/alumni-portal/admin/messages' },
      { key: 'users', label: 'USERS', href: '/alumni-portal/admin/users' },
      { key: 'analytics', label: 'ANALYTICS', href: '/alumni-portal/admin/analytics' },
    ]
  : [
      { key: 'home', label: 'SEARCH', href: '/alumni-portal/home' },
      { key: 'globe', label: 'GLOBE', href: '/alumni-portal/globe' },
      { key: 'profile', label: 'PROFILE', href: '/alumni-portal/profile' },
      ...(admin ? [{ key: 'admin', label: 'ADMIN', href: '/alumni-portal/admin' }] : []),
    ];
const right = variant === 'admin' ? { label: 'BACK', href: '/alumni-portal/home' } : { label: 'SIGN OUT', href: '/alumni-portal' };
---

<nav class="portal-nav t-nav" aria-label={variant === 'admin' ? 'Admin' : 'Alumni portal'}>
  <ul class="m-0 p-0 list-none flex portal-nav-list">
    {items.map((i) => (
      <li><a href={i.href} class:list={['no-underline glow-text', i.key === current ? 'text-ink' : 'text-muted']} aria-current={i.key === current ? 'page' : undefined}>{i.label}</a></li>
    ))}
  </ul>
  <a href={right.href} class="no-underline text-muted portal-signout">{right.label}</a>
</nav>
