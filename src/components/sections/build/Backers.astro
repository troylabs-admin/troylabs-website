---
/**
 * Build › Backers + apply — Section y 2900–4000 du.
 *   • rocket "Group 39628" 7042:2637 @40,2906 (rendered from Figma @3x)
 *   • "STARTUPS BACKED BY" 7041:2451 @374,3026 253×23 · logo frame "Frame 179" 7042:2588 @195,3107 611×189:
 *     Entrepreneurs First (image 169) @195,3106 166×81 · Collaborative Fund (image 170) @410,3115 396×50 ·
 *     ZhenFund (image 171) @195,3231 243×65 · Hattrick Capital (image 172) @537,3213 269×83
 *   • a stray colored ZhenFund logo (7041:2529) and the green "Vector 10" review curve exist in the frame — not rendered
 *     sits loose below the grid (looks like a leftover import) — reproduced 1:1, probably should be deleted.
 *   • big pill "Frame 156" 6997:1301 @329,3590 352.2×57.2 (34.3px text, inner shadow 23.3 white@40%, drop shadow 57 white@30%)
 *   • planet "Ellipse 259" 7042:2645 @675,3590 393×393 — DEVIATION (Bryan, 2026-08-23): rendered with the
 *     designer's textured orange planet (space/Planet.astro: atmosphere halo, breathing, mouse parallax)
 *     instead of Figma's flat disc render — the flag planet is the page's finale, it should look alive.
 *   • the "PREVIOUS STARTUPS" heading (6982:656) and its whole section were removed per Bryan (2026-08-23)
 */
import { Image } from 'astro:assets';
import { pos, u } from '../../../lib/units';
import Stars from '../../space/Stars.astro';
import Planet from '../../space/Planet.astro';
import rocket from '../../../assets/figma/build-rocket-b.png';
import flyer from '../../../assets/space/orange-rocket.png';
import Flag from './Flag.astro';

/* Flight box (du) large enough for the whole route; the path starts inside the Stats section's planet (abs centre 502.5,2517.5 r 283.5),
   and a radial mask on .flight hides whatever is inside that disc, so the rocket appears from behind the planet's edge. */
const FLIGHT = { x: -100, y: 2400, w: 1200, h: 1500 };
const MASK = { x: 502.5 - FLIGHT.x, y: 2517.5 - FLIGHT.y, r: 283.5 };
const FLIGHT_D = 'M480.0,160.0 C250.0,200.0 205.0,460.0 430.0,560.0 C620.0,610.0 800.0,590.0 940.0,610.0 C1090.0,632.0 1090.0,910.0 985.0,1030.0 C890.0,1138.0 660.0,1185.0 530.0,1270.0 C400.0,1340.0 350.0,1420.0 530.0,1450.0 C700.0,1480.0 860.0,1432.0 919.4,1416.8'; // Bryan's route (2026-08-23): from behind the stats planet → above "STARTUPS BACKED BY" → around the right of the logos → under the APPLY pill → loop back → land
import ef from '../../../assets/figma/build-logo-ef.svg?raw';
import collab from '../../../assets/figma/build-logo-collab.svg?raw';
import zhenfund from '../../../assets/figma/build-logo-zhenfund.svg?raw';
import hattrick from '../../../assets/figma/build-logo-hattrick.svg?raw';

const TOP = 2900;
const y = (v: number) => v - TOP;

/* rocket PNG = the Union's render bounds: 73.45×124.92 du at +57.82,+18.49 inside Group 39628 @40,2906 */
const ROCKET = { x: 97.82, y: 2924.49, w: 73.45, h: 124.92 };

const logos = [
  { svg: ef, box: [195, 3106, 166, 81], name: 'Entrepreneurs First' },
  { svg: collab, box: [410, 3115, 396, 50], name: 'Collaborative Fund' },
  { svg: zhenfund, box: [195, 3231, 243, 65], name: 'ZhenFund' },
  { svg: hattrick, box: [537, 3213, 269, 83], name: 'Hattrick Capital' },
];

const stars = [
  { x: 720, y: 3065, s: 11.5 }, { x: 490, y: 3305, s: 11.5 }, { x: 188, y: 3341, s: 11.5 }, { x: 278.1, y: 3420, s: 11.5 },
  { x: 895, y: 2920, s: 5.2, kind: 'dot' }, { x: 774, y: 2980, s: 5.2, kind: 'dot' }, { x: 556, y: 3091, s: 5.2, kind: 'dot' },
  { x: 422, y: 3304, s: 5.2, kind: 'dot' }, { x: 308, y: 3442.3, s: 5.2, kind: 'dot' }, { x: 78, y: 3534.3, s: 5.2, kind: 'dot' },
  { x: 198, y: 3684, s: 5.2, kind: 'dot' },
].map((s) => ({ ...s, y: y(s.y) })) as any;
---

<section class="section" style="--h:1100" data-figma="BuildBackers" aria-labelledby="backers-title">
  <Planet kind="orange" x={675} y={y(3590)} w={393} />
  <Stars items={stars} />
  <Image src={rocket} alt="" aria-hidden="true" width={221} height={375} class="abs pointer-events-none rocket-static" style={pos(ROCKET.x, y(ROCKET.y), ROCKET.w, ROCKET.h)} />

  <!-- motion layer: the rocket flies the designer's curve while this section scrolls (see motion.css) -->
  <svg class="abs pointer-events-none" style={pos(FLIGHT.x, y(FLIGHT.y), FLIGHT.w, FLIGHT.h)} viewBox={`0 0 ${FLIGHT.w} ${FLIGHT.h}`} aria-hidden="true">
    <path id="build-backers-path" d={FLIGHT_D} fill="none" stroke="none" />
  </svg>
  <!-- the flag planted on touchdown (motion only). Cloth is an SVG whose edges morph — a traveling
       wave from the pole to the fly, amplitude growing toward the free end (not a rigid card). -->
  <div class="abs flag pointer-events-none" style={pos(866, y(3822) - 100, 110, 100)} aria-hidden="true">
    <Flag />
  </div>
  <div class="abs rocket-flyer pointer-events-none" style={pos(FLIGHT.x, y(FLIGHT.y), FLIGHT.w, FLIGHT.h)} aria-hidden="true">
    <div class="flight" style={`width:${FLIGHT.w}px;height:${FLIGHT.h}px;transform-origin:0 0;transform:scale(var(--un, 1));-webkit-mask-image:radial-gradient(circle at ${MASK.x}px ${MASK.y}px, transparent ${MASK.r}px, #000 ${MASK.r + 1}px);mask-image:radial-gradient(circle at ${MASK.x}px ${MASK.y}px, transparent ${MASK.r}px, #000 ${MASK.r + 1}px)`}>
      <Image src={flyer} alt="" width={906} height={2048} class="flyer-img flyer-backers" style={`width:42px;height:95px;offset-path:path('${FLIGHT_D}')`} />
    </div>
  </div>

  <h2 id="backers-title" class="abs m-0 t-title font-normal text-center whitespace-nowrap glow" style={pos(374, y(3026), 253, 23)}>STARTUPS BACKED BY</h2>
  <ul class="m-0 p-0 list-none" aria-label="Investors who backed BUILD startups">
    {logos.map((l) => <li class="abs logo" data-hover="scale" style={pos(l.box[0], y(l.box[1]), l.box[2], l.box[3])} aria-label={l.name} set:html={l.svg} />)}
  </ul>

  <!-- TODO(designer): the pill links to the application form — URL not in Figma -->
  <a href="https://linktr.ee/TroyLabs" target="_blank" rel="noopener noreferrer" class="abs pill flex items-center justify-center no-underline text-ink" style={pos(329, y(3560), 352.2, 57.2)} /* 30 du above Figma (3590): tighter gap to the logos, Bryan 2026-08-23 */>
    <span class="t-apply whitespace-nowrap">APPLY TO BUILD</span>
  </a>


</section>

<!-- mobile: backers wall + pill + the conquered planet with its flag -->
<div class="m m-back m-pad m-stack" data-m="BuildBackers">
  <h2 class="m-0 t-title m-center font-normal glow">STARTUPS BACKED BY</h2>
  <ul class="m-blogos2 m-0 p-0 list-none" aria-label="Investors who backed BUILD startups">
    {logos.map((l) => <li class="m-blogo2" style={`width:${l.box[2] * 0.62}px`} aria-label={l.name} set:html={l.svg} />)}
  </ul>
  <a href="https://linktr.ee/TroyLabs" target="_blank" rel="noopener noreferrer" class="pill t-title m-pill no-underline text-ink">APPLY TO BUILD</a>
  <div class="m-art m-conq" data-aw={520} data-ah={430}>
    <Planet kind="orange" x={64} y={100} w={393} />
    <div class="abs m-flag" style={pos(320, 10, 110, 100)} aria-hidden="true">
      <Flag suffix="-m" />
    </div>
  </div>
</div>

<style>
  .logo :global(svg) { width: 100%; height: 100%; display: block; }
  .glow { text-shadow: 0 0 calc(8 * var(--u)) rgb(255 255 255 / 0.6); }
  .t-apply { font-size: calc(34.2857 * var(--u)); line-height: calc(39.4 * var(--u)); letter-spacing: calc(2.7 * var(--u)); }
  .pill {
    border-radius: 9999px;
    box-shadow:
      inset 0 0 0 calc(0.514 * var(--u)) #fff,
      inset 0 0 calc(23.3 * var(--u)) rgb(255 255 255 / 0.4),
      0 0 calc(57.1 * var(--u)) rgb(255 255 255 / 0.3);
  }
  @media (max-width: 767px) {
    .m-back { padding-block: 30px 0; gap: 8px; overflow: hidden; }
    .m-blogos2 { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px 28px; margin: 18px 0 22px; }
    .m-blogo2 :global(svg) { width: 100%; height: auto; display: block; }
    .m-conq { width: 100%; margin-top: 6px; margin-bottom: -10px; }
    /* the flag flies statically on mobile (no landing rocket): same cloth, always planted */
    .m-flag { display: block; transform-origin: 6% 100%; }
    .m-flag :global(.pole) { position: absolute; left: calc(4 * var(--u)); bottom: 0; width: calc(2.8 * var(--u)); height: 100%; background: #fff; border-radius: 1px; box-shadow: 0 0 calc(8 * var(--u)) rgb(255 255 255 / 0.6); }
    .m-flag :global(.cloth) { position: absolute; left: calc(6 * var(--u)); top: calc(-8 * var(--u)); width: calc(86 * var(--u)); height: calc(72 * var(--u)); overflow: visible; color: var(--color-orange); filter: drop-shadow(0 0 calc(8 * var(--u)) rgb(255 125 44 / 0.5)); }
    .m-flag :global(.mark path) { fill: #fff; }
  }
</style>
