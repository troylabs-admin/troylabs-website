---
/**
 * The BUILD flag (pole + waving cloth + TroyLabs mark) — shared by the desktop Backers section (planted
 * by the landing rocket) and the mobile tree (statically planted). `suffix` namespaces the gradient id:
 * the svg renders twice in the DOM and url(#…) refs into a display:none subtree don't paint.
 */
import flagMark from '../../../assets/figma/nav-rocket.svg?raw';
const markPath = flagMark.replace(/<\/?svg[^>]*>/g, '');
interface Props { suffix?: string }
const { suffix = '' } = Astro.props;
const id = `tl-flag-fill${suffix}`;
