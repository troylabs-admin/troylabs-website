---
/**
 * Build › Photo gallery — Section y 1778–2174 du. Eight image-fill frames in two rows of 198 du:
 *   row 1 (y 1778): Frame 127 @0 w299 · Frame 131 @301 w200 · Frame 170 @500 w299 · Frame 171 @799 w202
 *   row 2 (y 1976): Frame 175 @0 w202 · Frame 172 @202 w299 · Frame 174 @501 w202 · Frame 173 @702 w299
 * Photos are pre-cropped to each frame's Figma crop (FILL = cover, STRETCH = imageTransform) at 3× du.
 * FULL BLEED (Bryan, 2026-08-24): the strip breaks out of the 1440-capped artboard to true viewport width
 * so the photography runs edge to edge on any monitor — the same treatment DEMO's stage reel got. The
 * mosaic keeps its Figma proportions; only the container widens. On phones it becomes a swipeable strip.
 */
import { Image } from 'astro:assets';
import { pos } from '../../../lib/units';
import p1 from '../../../assets/figma/build-photo-1.jpg';
import p2 from '../../../assets/figma/build-photo-2.jpg';
import p3 from '../../../assets/figma/build-photo-3.jpg';
import p4 from '../../../assets/figma/build-photo-4.jpg';
import p5 from '../../../assets/figma/build-photo-5.jpg';
import p6 from '../../../assets/figma/build-photo-6.jpg';
import p7 from '../../../assets/figma/build-photo-7.jpg';
import p8 from '../../../assets/figma/build-photo-8.jpg';

const TOP = 1778;
const y = (v: number) => v - TOP;

const photos = [
  { src: p1, box: [0, 1778, 299, 198], id: '6989:970', alt: 'BUILD cohort on stage at LAUNCH Fall 2025' },
  { src: p2, box: [301, 1778, 200, 198], id: '6989:976', alt: 'Two members posing with TroyLabs gift bags' },
  { src: p3, box: [500, 1778, 299, 198], id: '7033:2205', alt: 'Founders with flowers after pitching' },
  { src: p4, box: [799, 1778, 202, 198], id: '7033:2207', alt: 'Speaker with a microphone' },
  { src: p5, box: [0, 1976, 202, 198], id: '7033:2212', alt: 'Two members celebrating' },
  { src: p6, box: [202, 1976, 299, 198], id: '7033:2209', alt: 'Team with an oversized check' },
  { src: p7, box: [501, 1976, 202, 198], id: '7033:2211', alt: 'Founders at LAUNCH Spring 2026' },
  { src: p8, box: [702, 1976, 299, 198], id: '7033:2210', alt: 'Group of members smiling' },
];
---

<section class="section gal-bleed" style="--h:396" data-figma="BuildGallery" aria-label="Photos from BUILD">
  <ul class="m-0 p-0 list-none">
    {photos.map((p) => (
      <li class="abs overflow-hidden" style={pos(p.box[0], y(p.box[1]), p.box[2], p.box[3])} data-figma={p.id}>
        <Image src={p.src} alt={p.alt} width={p.box[2] * 3} height={p.box[3] * 3} class="w-full h-full object-cover" />
      </li>
    ))}
  </ul>
</section>

<!-- mobile: 2-col mosaic, edge to edge -->
<ul class="m m-gal m-0 p-0 list-none" data-m="BuildGallery" aria-label="Photos from BUILD">
  {photos.map((p) => (
    <li class="m-gal-cell">
      <Image src={p.src} alt={p.alt} width={p.box[2] * 3} height={p.box[3] * 3} class="w-full h-full object-cover" />
    </li>
  ))}
</ul>

<style>
  /* break out of the centred artboard: full viewport width, mosaic scaled to match */
  .gal-bleed { width: 100vw; margin-left: calc((100% - 100vw) / 2); }
  .gal-bleed > ul { position: absolute; inset: 0; transform-origin: 0 0; transform: scale(calc(100vw / (1001 * var(--u)))); width: calc(1001 * var(--u)); height: 100%; }
  @media (max-width: 767px) {
    /* a swipeable strip: phones get the gallery as horizontal overflow with snap points, so all eight
       photos stay full-height instead of shrinking into a tiny grid (Bryan, 2026-08-24) */
    .m-gal {
      display: grid; grid-auto-flow: column; grid-auto-columns: 74vw; gap: 6px;
      overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
      padding-inline: 16px; -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .m-gal::-webkit-scrollbar { display: none; }
    .m-gal-cell { aspect-ratio: 3 / 2; overflow: hidden; border-radius: 10px; scroll-snap-align: center; }
  }
</style>
