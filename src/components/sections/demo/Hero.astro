---
/**
 * DEMO › Hero — Section y 79–560 du.
 * Figma: blue planet "Group 39628" (7040:2376) @-478.8,-369 1379×906 (the Home initiatives planet ×3.02, partly
 * off-canvas) · title "DEMO" 6982:868 @412,253 178×63 (blue→white vertical gradient, black drop shadow 10.9) ·
 * subtitle 6982:869 @307,338 387×40 (white→#548aff gradient, right end) · sponsor line 6990:997 @284,401 434×14 italic ·
 * star field. (The blue ambient glow "Ellipse 248" was deleted in the 2026-08-23 Figma update.)
 */
import { pos } from '../../../lib/units';
import Planet from '../../space/Planet.astro';
import Stars from '../../space/Stars.astro';

const TOP = 79;
const y = (v: number) => v - TOP;

const stars = [
  { x: 868, y: 86 }, { x: 677, y: 216 }, { x: 468, y: 455 }, { x: 212, y: 401 }, { x: 34, y: 365 }, { x: 321, y: 451 },
  // 4 du dots (Ellipse 228/229 sit inside the nav band, drawn from here)
  { x: 790, y: 28, kind: 'dot' }, { x: 904, y: 63, kind: 'dot' },
  // 5.3 du dots (Ellipse 270–275)
  { x: 78, y: 333, s: 5.3, kind: 'dot' }, { x: 252, y: 396, s: 5.3, kind: 'dot' }, { x: 237, y: 506, s: 5.3, kind: 'dot' },
  { x: 659, y: 267, s: 5.3, kind: 'dot' }, { x: 585, y: 248, s: 5.3, kind: 'dot' }, { x: 831, y: 196, s: 5.3, kind: 'dot' },
].map((s) => ({ ...s, y: y(s.y) })) as any;
---

<section class="section" style="--h:481" data-figma="DemoHero" aria-labelledby="demo-title">
  <!-- the planet reaches up behind the nav (y −369) and past the right edge of the canvas -->
  <Planet kind="blue" x={-478.8} y={y(-369)} w={1379} h={906} />
  <Stars items={stars} />

  <h1 id="demo-title" class="abs m-0 t-hero text-center whitespace-nowrap title" style={pos(412, y(253), 178, 63)}>DEMO</h1>
  <p class="abs m-0 t-tagline text-center subtitle" style={pos(307, y(338), 387, 40)}>SoCal’s largest student-run entrepreneurship conference</p>
  <p class="abs m-0 t-caption italic text-center whitespace-nowrap sponsor" style={pos(284, y(401), 434, 14)}>
    Sponsored by the USC Lloyd Greif Center for Entrepreneurial Studies
  </p>
</section>

<style>
  /* The group is wider than the 1001 du canvas: lift the global `img { max-width:100% }` cap (it would squash the
     planet to 1001×906), and paint it under the nav rocket/links (z-index −1 still sits above the html background). */
  section :global([data-planet="blue"]) { max-width: none; z-index: -1; }
  /* 6982:868 — gradient_linear handles (.5,0)→(.5,1): #006fff at the top, white at the bottom; drop shadow #000@70% 10.9 */
  .title {
    background: linear-gradient(180deg, var(--color-blue-deep) 0%, #fff 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 0 calc(10.9 * var(--u)) rgb(0 0 0 / 0.7));
  }
  /* 6982:869 — handles (1,.5)→(0,.5): #548aff at the right end, white from 10 % leftwards */
  .subtitle {
    background: linear-gradient(270deg, var(--color-blue) 0%, #fff 90%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .sponsor { letter-spacing: calc(1 * var(--u)); }
</style>
