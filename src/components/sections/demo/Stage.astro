---
/**
 * DEMO › Group photo + stats row — Section y 760–1919 du (2026-08-23 Figma update).
 * Figma: full-bleed photo — "Frame 170" (7099:3772) @1,821 1000×526 clipping the 558-tall
 * "Screenshot…" rectangle (7099:3773); no stroke/shadow on either ·
 * dark planet "Ellipse 8" (7045:2727) @160,1037 689×689 with blue inner shadows (demo-stats-planet.png @3x) ·
 * stats "Frame 171" (7019:18) @197,1539: 100+ INVESTORS · 50 STARTUPS · 1000+ ATTENDEES, white@70% glow 7.3 ·
 * comet "Ellipse 289" (7074:3769) @73,1758 142.6×113 + its star (7074:3770) @199.2,1855 · star field.
 * MEDIA (Bryan, 2026-08-24): the stage media breaks out of the 1440-capped page to true viewport width
 * (edge-to-edge on any monitor; at the 1001 fidelity viewport 100vw = the page, so the suite is
 * unaffected) with a top/bottom vignette that blends it into the sky — deliberately NO decorative frame.
 * VIDEO-READY: drop the reel at src/assets/demo-stage.mp4 (or .webm) and the slot switches from the
 * photo to an autoplaying muted loop (photo stays as poster) — no code change needed.
 */
import { Image } from 'astro:assets';
import { pos } from '../../../lib/units';
import Stars from '../../space/Stars.astro';
import photo from '../../../assets/figma/demo-stage-photo.png';
import planet from '../../../assets/figma/demo-stats-planet.png';
import comet from '../../../assets/figma/comet-streak-demo.png'; // DEMO's comet (7074:3769) is the mirror of BUILD's — own export

/* the reel, if it has landed (see MEDIA note above) + its captions (auto-transcribed, corrected by ear) */
const vids = import.meta.glob<string>('../../../assets/demo-stage.{mp4,webm}', { eager: true, query: '?url', import: 'default' });
const videoSrc = Object.values(vids)[0];
import captionsUrl from '../../../assets/demo-stage.vtt?url';

const TOP = 760;
const y = (v: number) => v - TOP;

/* each stat: number text box + label text box (Figma TEXT nodes, centered) */
const stats = [
  { value: '100+', label: 'INVESTORS', num: [218, 1549, 120], lab: [213, 1604, 129] },
  { value: '50', label: 'STARTUPS', num: [461, 1549, 58], lab: [431, 1604, 117] },
  { value: '1000+', label: 'ATTENDEES', num: [637, 1549, 151], lab: [645, 1604, 132] },
] as const;

const stars = [
  { x: 55, y: 845 }, { x: 126, y: 890 }, { x: 322, y: 1363 }, { x: 525, y: 1375 }, { x: 696, y: 1431 },
  { x: 866, y: 1694 }, { x: 939, y: 1850 }, { x: 833, y: 1520.7, s: 11.5 },
  { x: 199.2, y: 1855, s: 11.5 }, // the comet's star
  { x: 155, y: 870, s: 5.3, kind: 'dot' }, { x: 167, y: 1080, s: 5.3, kind: 'dot' }, { x: 349, y: 1385, s: 5.3, kind: 'dot' },
  { x: 645, y: 1413, s: 5.3, kind: 'dot' }, { x: 456, y: 1454, s: 5.3, kind: 'dot' }, { x: 655, y: 1454, s: 5.3, kind: 'dot' },
  { x: 792.1, y: 1493.9, s: 5.3, kind: 'dot' }, { x: 908, y: 1604, s: 5.3, kind: 'dot' }, { x: 908, y: 1770, s: 5.3, kind: 'dot' },
  { x: 964, y: 1802, s: 5.3, kind: 'dot' },
].map((s) => ({ ...s, y: y(s.y) })) as any;
---

<section class="section" style="--h:1159" data-figma="DemoStage" aria-label="DEMO by the numbers">
  <Image src={planet} alt="" aria-hidden="true" width={2067} height={2067} class="abs pointer-events-none" style={pos(160, y(1037), 689, 689)} />
  <Stars items={stars} />
  <Image src={comet} alt="" aria-hidden="true" width={428} height={339} class="abs pointer-events-none" style={pos(73, y(1758), 142.6, 113)} />

  <!-- "Frame 170" band @821, broken out to true viewport width (see MEDIA note) -->
  <figure class="abs m-0 overflow-hidden media" style={`${pos(0, y(821), 1000, 526)};width:100vw;margin-left:calc((100% - 100vw) / 2)`}>
    {videoSrc ? (
      <>
        <video class="w-full h-full object-cover" crossorigin="anonymous" poster={photo.src} muted loop playsinline preload="none" aria-label="Highlights from DEMO">
          <source src={videoSrc} type="video/mp4" />
          <track kind="captions" src={captionsUrl} srclang="en" label="English" default />
        </video>
        <p class="cap" aria-hidden="true"></p>
        <button class="sound" type="button" aria-label="Unmute video" aria-pressed="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 5 6.5 9H3v6h3.5L11 19V5Z" fill="currentColor" stroke="none" />
            <path class="wave" d="M15 9.2a4.2 4.2 0 0 1 0 5.6" />
            <path class="wave" d="M17.6 6.8a8 8 0 0 1 0 10.4" />
            <line class="slash" x1="4" y1="20" x2="20" y2="4" />
          </svg>
        </button>
      </>
    ) : (
      <Image src={photo} alt="TroyLabs members on stage at DEMO" width={1978} height={1104} class="w-full h-full object-cover" />
    )}
  </figure>

  <dl class="m-0">
    {stats.map((s) => (
      <div>
        <dd class="abs m-0 t-stat text-center whitespace-nowrap stat" style={pos(s.num[0], y(s.num[1]), s.num[2], 55)}>{s.value}</dd>
        <dt class="abs m-0 t-title text-center whitespace-nowrap stat" style={pos(s.lab[0], y(s.lab[1]), s.lab[2], 23)}>{s.label}</dt>
      </div>
    ))}
  </dl>
</section>

<script>
  /* the reel: plays only while on screen (muted), pauses off-screen; the corner button toggles sound.
     Reduced motion: no autoplay — the poster stands, and the sound button (which only serves the
     autoplaying reel) is removed. Re-runs after ClientRouter swaps. */
  function initReel() {
    const wrap = document.querySelector<HTMLElement>('[data-figma="DemoStage"] .media');
    const video = wrap?.querySelector('video');
    if (!wrap || !video || video.dataset.wired) return;
    video.dataset.wired = '1';
    const btn = wrap.querySelector<HTMLButtonElement>('.sound');
    if (!document.documentElement.classList.contains('motion')) { btn?.remove(); return; }
    new IntersectionObserver(([e]) => { if (e.isIntersecting) video.play().catch(() => {}); else video.pause(); }, { threshold: 0.25 }).observe(wrap);
    // captions: native track kept hidden, rendered into our own tiny pill (native cue chrome is huge)
    const cap = wrap.querySelector<HTMLElement>('.cap');
    const track = video.textTracks[0];
    if (cap && track) {
      track.mode = 'hidden';
      track.addEventListener('cuechange', () => {
        const cue = track.activeCues?.[0] as VTTCue | undefined;
        cap.textContent = cue?.text ?? '';
        cap.classList.toggle('is-on', !!cue);
      });
    }
    btn?.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted) video.volume = 1;
      btn.classList.toggle('is-on', !video.muted);
      btn.setAttribute('aria-pressed', String(!video.muted));
      btn.setAttribute('aria-label', video.muted ? 'Unmute video' : 'Mute video');
    });
  }
  initReel();
  document.addEventListener('astro:page-load', initReel);
</script>

<style>
  /* blend the media into the sky instead of framing it: soft dark falloff top and bottom, hard sides */
  .media::after { content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgb(10 10 11 / 0.85), transparent 14%, transparent 86%, rgb(10 10 11 / 0.85)); }
  .stat { text-shadow: 0 0 calc(7.3 * var(--u)) rgb(255 255 255 / 0.7); }
  /* tiny captions: our own renderer, bottom-centre, above the vignette */
  .cap {
    position: absolute; z-index: 1; left: 50%; bottom: calc(26 * var(--u)); transform: translateX(-50%);
    max-width: 62%; margin: 0; padding: calc(4 * var(--u)) calc(12 * var(--u));
    font-size: calc(13 * var(--u)); line-height: calc(17 * var(--u)); letter-spacing: calc(0.4 * var(--u)); text-align: center;
    color: rgb(255 255 255 / 0.95); background: rgb(0 0 0 / 0.55); border-radius: calc(6 * var(--u));
    opacity: 0; transition: opacity 200ms var(--ease-out-expo); pointer-events: none;
  }
  .cap.is-on { opacity: 1; }
  /* sound toggle: the site's pill language, sitting above the vignette (::after has no z-index) */
  .sound {
    position: absolute; z-index: 1; right: calc(28 * var(--u)); bottom: calc(28 * var(--u));
    width: calc(44 * var(--u)); height: calc(44 * var(--u)); padding: calc(10 * var(--u));
    border: 0; border-radius: 9999px; cursor: pointer; color: #fff;
    background: rgb(10 10 11 / 0.45); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    box-shadow: inset 0 0 0 calc(0.33 * var(--u)) rgb(255 255 255 / 0.7);
    opacity: 0.85; transition: opacity 200ms var(--ease-out-expo), box-shadow 200ms var(--ease-out-expo);
  }
  .sound:hover, .sound:focus-visible { opacity: 1; box-shadow: inset 0 0 0 calc(0.33 * var(--u)) #fff, 0 0 calc(18 * var(--u)) rgb(255 255 255 / 0.25); }
  .sound svg { width: 100%; height: 100%; display: block; }
  .sound .wave { opacity: 0; transition: opacity 150ms; }
  .sound .slash { transition: opacity 150ms; }
  .sound.is-on .wave { opacity: 1; }
  .sound.is-on .slash { opacity: 0; }
</style>
