---
/**
 * Home › Executive Board — Section y 4050–5433 du.
 * Figma: title 7028:1996 · grid "Frame 109" @127,4168: 4 columns at x = 127 / 334.8 / 542.5 / 750.3,
 * 5 rows at y = 4168 / 4397.1 / 4626.2 / 4873.4 / 5120.4. Card = 145×145 photo (r 16.4) + name + role, gap 6.56.
 * DEVIATION (Bryan, 2026-08-23): section ends 150 du earlier than the Figma's 5583 — the empty band under
 * the last row read as a hole once real photos filled the grid. The flight path's final hook shifted with
 * it, and the ambient glow is trimmed to end at the new page bottom (its tail is ~invisible at 5% alpha).
 * Members & placement come from src/content/board.json (generated from the Figma grid).
 * Photos: real headshots in src/assets/board/ (pnpm assets:board from the raw "E-Board Photos/" folder,
 * keyed by board.json's "photo" field); the checkerboard placeholder remains as the fallback.
 * Each card is a LinkedIn link (new tab) — URLs live on the member records.
 */
import { Image } from 'astro:assets';
import { pos, u } from '../../../lib/units';
import Glow from '../../space/Glow.astro';
import placeholder from '../../../assets/figma/photo-placeholder.png';
import board from '../../../content/board.json';

const photos = import.meta.glob<{ default: ImageMetadata }>('../../../assets/board/*.jpg', { eager: true });
const photoFor = (key: string | null) => (key ? photos[`../../../assets/board/${key}.jpg`]?.default : undefined);

const TOP = 4050;
const y = (v: number) => v - TOP;
const COLS = [127, 334.8, 542.5, 750.3];
const ROWS = [4168, 4397.1, 4626.2, 4873.4, 5120.4];
---

<section class="section" style="--h:1383" data-figma="Board" aria-labelledby="board-title">
  <Glow x={310} y={y(4847)} w={745.3} h={842} pad={0} /> {/* page-bottom glow: padding would grow the document (see Glow.astro) */}
  <h2 id="board-title" class="abs m-0 t-title-tight font-normal text-center whitespace-nowrap" style={pos(414, y(4082), 199, 23)}>EXECUTIVE BOARD</h2>

  <ul class="m-0 p-0 list-none">
    {board.map((m) => (
      <li class="abs" data-hover="lift" style={pos(COLS[m.col], y(ROWS[m.row]), 148.8)}>
        <a
          href={m.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center text-center no-underline text-ink"
          style={`gap:${u(6.56)}`}
          aria-label={`${m.name}, ${m.role} — LinkedIn`}
        >
          <Image
            src={photoFor(m.photo) ?? placeholder} alt="" width={256} height={256}
            class="shrink-0 object-cover" style={`width:${u(145)};height:${u(145)};border-radius:${u(16.4)}`}
          />
          <h3 class="m-0 t-name font-normal">{m.name}</h3>
          <p class="m-0 t-caption italic">{m.role}</p>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .t-caption { letter-spacing: calc(0.36 * var(--u)); }
</style>
