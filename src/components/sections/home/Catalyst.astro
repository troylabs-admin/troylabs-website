---
/**
 * Home › "The student catalyst behind startups." — Section y 1900–3200 du.
 *   • heading 7028:1594 + blurb 7028:1595
 *   • 50 ACTIVE MEMBERS: counter swarm (Bryan's pick 2026-08-24, replacing the Figma starburst "Star 8"
 *     7028:2092 @147,2139 315×316 — masked in the fidelity suite): 50 of the designer's glow dots hold the
 *     numeral "50"; hovering scatters each along its own vector and it reforms on leave. Layout is baked in
 *     (points sampled once inside the glyph, 900 150px Helvetica on a 300×160 canvas, seed 7, min gap 13)
 *     so the render is deterministic and the formed numeral is the reduced-motion rest state.
 *   • 13 MAJORS: 15 glass orbs (Ellipse 190…245, grey-orb.png) with labels + 4 connector lines
 *   • 6 DIVISIONS: star icons (Frame 96), dotted timeline lines, six role cards (Frame 97–102)
 */
import { Image } from 'astro:assets';
import { pos, u } from '../../../lib/units';
import Stars from '../../space/Stars.astro';
import Glow from '../../space/Glow.astro';
import swarmDot from '../../../assets/space/small-circle.png';
import star1 from '../../../assets/space/star-1.png';
import star2 from '../../../assets/space/star-2.png';
import star3 from '../../../assets/space/star-3.png';
import star4 from '../../../assets/space/star-4.png';
import star5 from '../../../assets/space/star-5.png';
import star6 from '../../../assets/space/star-6.png';
import rocketMark from '../../../assets/figma/nav-rocket.svg?raw';

const TOP = 1900;
const y = (v: number) => v - TOP;

/* 50 active members — counter swarm. Points are canvas coords (300×160) inside the "50" glyph, mapped into
   the starburst's old 315×316 box (×1.05, numeral centred vertically). Each dot is the designer's glow-dot
   glyph (small-circle.png, ring = 25.4% of the png — same scale Stars.astro uses), so the swarm speaks the
   exact star/dot language of the constellation beside it. Seeded rng: sizes, scatter vectors, twinkle. */
const SWARM_PTS = [[156,64],[139,38],[165,116],[87,85],[166,99],[110,68],[210,110],[217,87],[128,102],[93,37],[194,128],[182,117],[131,76],[168,46],[197,25],[207,62],[117,114],[139,89],[90,110],[208,41],[104,126],[92,64],[117,130],[75,117],[221,60],[184,39],[90,127],[119,44],[171,75],[130,27],[141,105],[222,102],[77,67],[160,82],[167,33],[132,121],[107,30],[216,74],[79,49],[121,89],[175,129],[99,76],[80,31],[78,104],[175,60],[207,97],[104,44],[209,126],[92,50],[173,88]];
const swarmRng = (() => { let a = 7; return () => { a |= 0; a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; })();
const DOT_SCALE = 1 / 0.254; // glyph png body ratio (Stars.astro)
const swarm = SWARM_PTS.map(([px, py], i) => {
  const d = 3.2 + swarmRng() * 1.8;                        // dot body in du
  const box = d * DOT_SCALE;
  return {
    x: px * 1.05 - box / 2, y: 74 + py * 1.05 - box / 2, box, // numeral spans the box width; 160×1.05 tall, centred
    sx: ((swarmRng() - 0.5) * 260).toFixed(1), sy: ((swarmRng() - 0.5) * 190).toFixed(1), // scatter vector (du)
    dur: (2.6 + ((i * 7) % 5) * 0.45).toFixed(2),          // twinkle spread, same recipe as Stars.astro
  };
});

/* 13 majors — a constellation in the shape of the TroyLabs rocket mark (decision 2026-08-23; the Figma's glass orbs
   were placeholders). 13 silhouette points of nav-rocket.svg (26×39 units), traced clockwise from the nose, scaled
   ×7.6 and placed in the area the orbs occupied. `s` = star size class; `side` = where the label sits (outward). */
const ROCKET = [[13.3, 0.25], [20.1, 10.6], [22.2, 20.5], [26.0, 33.2], [25.8, 38.7], [17.2, 36.7], [13.1, 34.3], [8.6, 36.5], [0.3, 38.7], [0.1, 33.3], [3.9, 20.8], [6.1, 9.7], [9.6, 4.0]];
const RX = 625, RY = 2128, RS = 7.6;
const names = ['Computer Science', 'Business Administration', 'Economics', 'Communications', 'Arts, Technology & Business', 'Design', 'AI for Business', 'History', 'PR & Advertising', 'Political Science', 'Philosophy, Politics & Law', 'Electrical & Computer Engineering', 'Human Development & Aging'];
const sizes = [3, 2, 3, 3, 2, 1, 2, 1, 2, 2, 3, 3, 2];
const majors = names.map((label, i) => ({ label, s: sizes[i], c: [RX + ROCKET[i][0] * RS, RY + ROCKET[i][1] * RS] }));
/* the figure itself: the rocket mark's path (ghost line, like the drawings on a star chart) + small unnamed stars
   sampled along its outline (every 1/60 of its length, skipping points within 2.2 units of a major) */
const ROCKET_PATH_D = rocketMark.match(/ d="([^"]+)"/)![1];
const MINORS = [[21.3,32.8],[19.3,34.7],[17.1,34.3],[17,31.6],[15.7,29.2],[18.4,28.8],[18.7,26.9],[16.1,27.4],[14.3,28.8],[14.5,31.5],[11.4,31.1],[11.6,28.4],[9.4,27.3],[6.7,26.8],[7.9,28.9],[9.9,29.6],[8.7,32],[6.2,34.3],[4.3,33.4],[2.7,35.6],[0,29.8],[0.5,27.1],[1.9,24.8],[4.3,17.4],[4.7,14.7],[5.3,12.1],[7.2,7],[16.1,3.1],[17.7,5.3],[19,7.7],[20.8,12.8],[21.3,15.4],[21.6,18.1],[22.9,23.2],[24.5,25.4],[25.7,27.8],[26,30.5],[25.9,35.9],[22.9,35]];
/* edges: the outline, star to star */
const edges: [number, number][] = majors.map((_, i) => [i, (i + 1) % majors.length] as [number, number]);
/* entrance stagger: ranked by vertical position so the constellation assembles top-to-bottom (nose first,
   sweeping down to the base) — not in outline order. An edge appears when the sweep reaches its lower star. */
const rank: number[] = [];
majors.map((m, i) => [m.c[1], i] as const).sort((a, b) => a[0] - b[0]).forEach(([, i], r) => (rank[i] = r));
const minorRank: number[] = [];
MINORS.map((m, i) => [m[1], i] as const).sort((a, b) => a[0] - b[0]).forEach(([, i], r) => (minorRank[i] = r));
/* label side: outward from the rocket's axis (x = 13), nose above, base below */
const side: Record<number, 'l' | 'r' | 't' | 'b' | 'bb'> = { 0: 't', 1: 'r', 2: 'r', 3: 'r', 4: 'r', 5: 'b', 6: 'bb', 7: 'b', 8: 'l', 9: 'l', 10: 'l', 11: 'l', 12: 'l' }; // 'bb' = second row below (the nozzle sits between two base stars)

/* 6 divisions: icon, timeline (dot → line → dot), card.
   Icon placement: the Figma STAR nodes have inner shadows that darken their edges, so the visible shape is
   smaller than the node box. `box` is the visible extent measured in the 1:1 reference render, and `body`
   is the measured shape/png ratio of the exported star PNG (which carries a glow halo) — together they put
   the shape exactly where Figma draws it. */
const divisions = [
  { icon: star1, body: 0.864, box: [182, 2593, 38, 40], line: [201, 2665.4, 50], dots: [[197, 2656], [197, 2715.4]], card: [109, 2739.4, 184, 86], name: 'PRODUCT MANAGER', textBox: [109, 2769.4, 184], text: 'Partner with founders to set core goals, own development timelines, and run user research to ship market-ready products.' },
  { icon: star2, body: 0.675, box: [303, 2595, 31, 36], line: [317, 2664, 213], dots: [[313, 2656], [313, 2877]], card: [226, 2907, 184, 100], name: 'FINANCE/VC', textBox: [239, 2937, 158], text: 'Build budgets, run deal analysis, and prep founders for seed-stage fundraising while connecting startups directly to VC networks.' },
  { icon: star3, body: 0.91, box: [418, 2594, 39, 38], line: [437, 2665.4, 50], dots: [[433, 2656], [433, 2715.4]], card: [341, 2739, 184, 86], name: 'DESIGN', textBox: [351, 2769, 164], text: 'Craft intuitive UI/UX and distinct visual identities that elevate brand appeal and streamline user experiences.' },
  { icon: star4, body: 0.677, box: [542, 2595, 36, 36], line: [559, 2664, 213], dots: [[555, 2656], [555, 2877]], card: [467, 2907, 184, 100], name: 'ENGINEER', textBox: [480, 2937, 158], text: 'Build high-performance web and mobile products across modern tech stacks. Solve complex technical problems and deploy code.' },
  { icon: star5, body: 0.85, box: [663, 2593, 34, 40], line: [679, 2665.4, 50], dots: [[675, 2656], [675, 2715.4]], card: [588, 2739, 184, 114], name: 'DEMO', textBox: [601, 2769, 158], text: 'Manage operations, marketing, and curate our annual flagship startup conference while building high-value ecosystem networks.' },
  { icon: star6, body: 0.71, box: [781, 2592, 39, 38], line: [799, 2664, 213], dots: [[795, 2656], [795, 2877]], card: [709, 2907, 184, 100], name: 'MARKETING', textBox: [722, 2937, 158], text: 'Execute targeted campaigns, analyze market trends, and capture growth opportunities to drive visibility and traction.' },
];

const stars = [
  { x: 90, y: 2146.5, s: 10.4 }, { x: 58.6, y: 2080.8, s: 10.4 }, { x: 855, y: 2089 }, { x: 915, y: 2189 },
  { x: 72.1, y: 2173.6, s: 4.6, kind: 'dot' }, { x: 203.1, y: 2143.6, s: 4.6, kind: 'dot' }, { x: 32, y: 1993, kind: 'dot' },
  { x: 526.1, y: 2143.6, s: 4.6, kind: 'dot' }, { x: 826.1, y: 2443.6, s: 4.6, kind: 'dot' }, { x: 896.1, y: 2183.6, s: 4.6, kind: 'dot' },
].map((s) => ({ ...s, y: y(s.y) })) as any;
---

<section class="section" style="--h:1300" data-figma="Catalyst" aria-labelledby="catalyst-title">
  <Glow x={241.9} y={y(2046.1)} w={779.7} h={901.3} />
  <Stars items={stars} />

  <h2 id="catalyst-title" class="abs m-0 t-title-tight font-normal text-center whitespace-nowrap" style={pos(305, y(1943), 349, 23)}>The student catalyst behind startups.</h2>
  <p class="abs m-0 t-caption text-center" style={pos(207, y(1985), 549, 28)}>
    We’re an eclectic crew of hackers, designers, and visionaries across USC.<br />
    Different majors, same obsession: building cool stuff and backing our founders to do the same.
  </p>

  <!-- 50 active members: the counter swarm (hover scatters, motion.css reforms it) -->
  <h3 class="abs m-0 t-label font-normal whitespace-nowrap" style={pos(225, y(2086), 153, 14)}>50 ACTIVE MEMBERS</h3>
  <div class="abs swarm" data-reveal-unit aria-hidden="true" style={pos(147, y(2139), 315, 316)}>
    {swarm.map((d, i) => (
      <Image src={swarmDot} alt="" width={48} height={48} class="abs star" style={`${pos(d.x, d.y, d.box, d.box)};--i:${i};--dur:${d.dur}s;--dim:0.5;--sx:${d.sx};--sy:${d.sy}`} />
    ))}
  </div>

  <!-- 13 majors: constellation (scripts/constellation.ts drifts the stars and brightens links on hover).
       The svg spans the whole section, so the generic reveal would fire off-screen — instead the sentinel
       marks the artwork's box and constellation.ts assembles the figure when IT scrolls into view. -->
  <h3 class="abs m-0 t-label font-normal whitespace-nowrap" style={pos(645, y(2086), 82, 14)}>13 MAJORS</h3>
  <div class="abs pointer-events-none" style={pos(520, y(2060), 400, 400)} data-constellation-sentinel aria-hidden="true" />
  <svg class="abs constellation" style={pos(0, 0, 1001, 1300)} viewBox="0 0 1001 1300" data-constellation aria-label="Majors represented">
    <path class="figure" d={ROCKET_PATH_D} transform={`translate(${RX} ${y(RY)}) scale(${RS})`} />
    {MINORS.map(([mx, my], mi) => <circle class="minor" style={`--j:${minorRank[mi]}`} cx={RX + mx * RS} cy={y(RY + my * RS)} r="0.9" />)}
    {edges.map(([a, b]) => <line data-edge={`${a}-${b}`} style={`--i:${Math.max(rank[a], rank[b])}`} x1={majors[a].c[0]} y1={y(majors[a].c[1])} x2={majors[b].c[0]} y2={y(majors[b].c[1])} />)}
    {majors.map((m, i) => {
      const [cx, cy] = [m.c[0], y(m.c[1])]; const r = [0, 2.2, 3, 3.8][m.s];
      const tx = side[i] === 'l' ? cx - r - 6 : side[i] === 'r' ? cx + r + 6 : cx; const ty = side[i] === 'b' ? cy + r + 11 : side[i] === 'bb' ? cy + r + 46 : side[i] === 't' ? cy - r - 6 : cy + 2.5;
      const anchor = side[i] === 'l' ? 'end' : side[i] === 'r' ? 'start' : 'middle';
      return (
        <g class="node" data-node={i} tabindex="0" role="img" aria-label={m.label} style={`--nx:${cx};--ny:${cy};--i:${rank[i]}`}>
          <circle class="halo" cx={cx} cy={cy} r={r * 4} />
          <circle class="core" cx={cx} cy={cy} r={r} />
          <text x={tx} y={ty} text-anchor={anchor}>{m.label}</text>
        </g>
      );
    })}
  </svg>

  <!-- 6 divisions -->
  <h3 class="abs m-0 t-title-tight font-normal text-center whitespace-nowrap" style={pos(422, y(2537), 124, 23)}>6 DIVISIONS</h3>
  <ul class="m-0 p-0 list-none">
    {divisions.map((d, i) => {
      const [bx, by, bw, bh] = d.box; const pw = bw / d.body, ph = bh / d.body;
      return (
        <li data-division={d.name} style={`--i:${i}`}>
          <Image src={d.icon} alt="" aria-hidden="true" width={300} height={300} class="abs pointer-events-none" style={pos(bx - (pw - bw) / 2, y(by) - (ph - bh) / 2, pw, ph)} />
          <span class="abs timeline" style={pos(d.line[0], y(d.line[1]), 0, d.line[2])} aria-hidden="true" />
          {d.dots.map(([dx, dy]) => <span class="abs dot" style={pos(dx, y(dy), 9, 9)} aria-hidden="true" />)}
          <article class="abs flex flex-col items-center text-center" style={`${pos(d.card[0], y(d.card[1]), d.card[2], d.card[3])};gap:${u(8)}`}>
            <h4 class="m-0 t-label font-normal whitespace-nowrap">{d.name}</h4>
            <hr class="m-0 border-0 border-t border-ink/100 shrink-0" style={`width:${u(58)}`} />
            <p class="m-0 t-caption w-du" style={`--w:${d.textBox[2]}`}>{d.text}</p>
          </article>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .timeline { border-left: calc(1 * var(--u)) solid #fff; filter: drop-shadow(0 0 calc(7.1 * var(--u)) rgb(255 255 255 / 0.6)); }
  .dot { border-radius: 9999px; background: #fff; filter: drop-shadow(0 0 calc(7.1 * var(--u)) rgb(255 255 255 / 0.6)); }
  .t-caption { letter-spacing: calc(0.4 * var(--u)); }
</style>
