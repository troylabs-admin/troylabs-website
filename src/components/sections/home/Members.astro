---
/**
 * Home › "Our members are part of" — globe with company names orbiting it. Section y 3200–4050 du.
 * Figma: title 7028:1995 · globe "Group 3" (7028:1968) @310,3388 387×387 · four vector logos with
 * leader lines to dots on the globe edge · plain-text company names · orange glow "Ellipse 252".
 */
import { Image } from 'astro:assets';
import { pos, u } from '../../../lib/units';
import Stars from '../../space/Stars.astro';
import Glow from '../../space/Glow.astro';
import globe from '../../../assets/figma/globe.png';
import google from '../../../assets/figma/logo-google.svg?raw';
import anthropic from '../../../assets/figma/logo-anthropic.svg?raw';
import sony from '../../../assets/figma/logo-sony.svg?raw';
import apple from '../../../assets/logos/apple.svg?raw'; // rebuilt: Apple glyph + wordmark at the weight of the other marks (her vector read thin/small)
import vercel from '../../../assets/logos/vercel.svg?raw';
import estee from '../../../assets/logos/estee.svg?raw';
import nvidia from '../../../assets/logos/nvidia.svg?raw';
import ramp from '../../../assets/logos/ramp.svg?raw';
import meta from '../../../assets/logos/meta.svg?raw';
import ibm from '../../../assets/logos/ibm.svg?raw';
import kleiner from '../../../assets/logos/kleiner.svg?raw';
import disney from '../../../assets/logos/disney.svg?raw';
import tesla from '../../../assets/logos/tesla.svg?raw';
import aws from '../../../assets/logos/aws.svg?raw';

const TOP = 3200;
const y = (v: number) => v - TOP;

/* globe.png is a 3× Figma render incl. effects: 1202×1201 px → 400.7×400.3 du around the 387 du group */
const g = { w: 1202 / 3, h: 1201 / 3 };
const gPad = { x: (g.w - 387) / 2, y: (g.h - 387) / 2 };

const logos = [
  { svg: google, box: [282, 3360, 49, 16.1], name: 'Google' },
  { svg: anthropic, box: [178, 3432, 105, 11.8], name: 'Anthropic' },
  { svg: sony, box: [126, 3555, 68, 22.2], name: 'Sony Pictures' },
  { svg: apple, box: [164, 3609, 67, 22], name: 'Apple' },
];
/* leader lines (Line 32–39) as polylines, and their end dots (Ellipse 253–256, 7 du) */
const leaders = [
  [[338, 3368], [369, 3368], [369, 3439]],              // Google → dot @366,3438
  [[278, 3458], [278, 3476], [338, 3476]],              // Anthropic → dot @338,3472
  [[204, 3566], [275, 3566], [275, 3535], [312, 3535]], // Sony → dot @312,3532
  [[242, 3620], [310, 3620]],                           // Apple → dot @310,3617
];
const dots = [[366, 3438], [338, 3472], [312, 3532], [310, 3617]];

/* Company wordmarks (monochrome, currentColor) replace Figma's plain-text names — Bryan's call 2026-08-23, to match
   the vector logos (Google/Anthropic/Sony/Apple) she drew. Each is centred on the original text box; `h` is the
   logo height in du, chosen so the set reads as one family. Sources: Wikimedia Commons SVGs (see design/README.md).
   Entrepreneurs First and 8VC have no usable vector available → styled text, TODO(designer). */
const marks = [
  { name: 'Vercel', svg: vercel, key: 'vercel', h: 12.5, box: [425, 3331, 39] },
  { name: 'Estée Lauder', svg: estee, key: 'estee', h: 22, box: [587, 3339, 82] },
  { name: 'NVIDIA', svg: nvidia, key: 'nvidia', h: 12, box: [708, 3415, 45] },
  { name: 'Entrepreneurs First', text: 'ENTREPRENEUR FIRST', box: [746, 3497, 121] },
  { name: 'Ramp', svg: ramp, key: 'ramp', h: 12.5, box: [801, 3582, 35] },
  { name: 'Meta', svg: meta, key: 'meta', h: 12.5, box: [753, 3653, 30] },
  { name: 'IBM', svg: ibm, key: 'ibm', h: 15, box: [218, 3716, 24] },
  { name: '8VC', text: '8VC', box: [710, 3730, 26] },
  { name: 'Kleiner Perkins', svg: kleiner, key: 'kleiner', h: 12.5, box: [222, 3785, 95] },
  { name: 'The Walt Disney Company', svg: disney, key: 'disney', h: 16, box: [572, 3810, 164] },
  { name: 'Tesla', svg: tesla, key: 'tesla', h: 11.5, box: [386, 3824, 32] },
  { name: 'AWS', svg: aws, key: 'aws', h: 26, box: [489, 3855, 29] },
] as const;
const ASPECT: Record<string, number> = {"kleiner": 9.526, "meta": 4.963, "tesla": 7.671, "estee": 1.669, "aws": 1.67, "disney": 6.605, "ibm": 2.68, "nvidia": 7.022, "vercel": 4.369, "ramp": 3.692};

const stars = [
  { x: 113, y: 3426, s: 12.7 }, { x: 177.3, y: 3344.7, s: 11.2 }, { x: 66, y: 3223, s: 11 }, { x: 43, y: 3209, s: 5, kind: 'dot' },
].map((s) => ({ ...s, y: y(s.y) })) as any;
---

<section class="section" style="--h:850" data-figma="Members" aria-labelledby="members-title">
  <Glow x={-53} y={y(3555)} w={782.5} h={900} />
  <Stars items={stars} />

  <h2 id="members-title" class="abs m-0 t-sub font-normal text-center whitespace-nowrap" style={pos(402, y(3252), 204, 18)}>Our members are part of</h2>

  <div class="abs globe pointer-events-none" style={pos(310, y(3388), 387, 387)} data-globe aria-hidden="true">
    <!-- static: Figma's render (also the reduced-motion / no-JS state) -->
    <Image src={globe} alt="" width={1202} height={1201} class="globe-static" style={`position:absolute;left:${u(-gPad.x)};top:${u(-gPad.y)};width:${u(g.w)};height:${u(g.h)};max-width:none`} />
    <!-- live: orthographic globe drawn by src/scripts/globe.ts in the same line-art language -->
    <svg class="globe-live" viewBox="0 0 387 387" width="387" height="387">
      <defs>
        <radialGradient id="globe-shade" cx="38%" cy="32%" r="75%">
          <stop offset="0" stop-color="#1c1c1c" /><stop offset="0.6" stop-color="#0b0b0b" /><stop offset="1" stop-color="#050505" />
        </radialGradient>
        <filter id="globe-glow" x="-10%" y="-10%" width="120%" height="120%"><feGaussianBlur stdDeviation="1.6" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
        <filter id="globe-rim" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="4" /></filter>
      </defs>
      <circle cx="193.5" cy="193.5" r="192" fill="none" stroke="#fff" stroke-opacity="0.55" stroke-width="3" filter="url(#globe-rim)" />
      <circle cx="193.5" cy="193.5" r="192" fill="url(#globe-shade)" stroke="#fff" stroke-opacity="0.7" stroke-width="0.6" />
      <path data-graticule fill="none" stroke="#fff" stroke-opacity="0.07" stroke-width="0.4" />
      <!-- glow = a wider faint stroke under the crisp one (an SVG blur filter here would re-rasterize every frame) -->
      <path data-land-glow fill="none" stroke="#fff" stroke-opacity="0.18" stroke-width="3" stroke-linejoin="round" />
      <path data-land fill="rgba(255,255,255,0.03)" stroke="#fff" stroke-opacity="0.85" stroke-width="0.9" stroke-linejoin="round" />
    </svg>
  </div>

  <svg class="abs pointer-events-none leaders" style={pos(0, 0, 1001, 850)} viewBox="0 0 1001 850" aria-hidden="true">
    {leaders.map((pts) => <polyline points={pts.map(([px, py]) => `${px},${y(py)}`).join(' ')} fill="none" stroke="#fff" stroke-width="0.33" />)}
    {dots.map(([dx, dy]) => <circle cx={dx + 3.5} cy={y(dy) + 3.5} r="3.5" fill="#fff" />)}
  </svg>

  <ul class="m-0 p-0 list-none" aria-label="Companies our members have worked at">
    {logos.map((l) => (
      <li class="abs logo" style={pos(l.box[0], y(l.box[1]), l.box[2], l.box[3])} aria-label={l.name} set:html={l.svg} />
    ))}
    {marks.map((m) => {
      const [bx, by, bw] = m.box; const cx = bx + bw / 2, cy = by + 7;   // centre of the original 14 du text line
      if ('text' in m) return <li class="abs company whitespace-nowrap text-center" style={pos(bx, y(by), bw, 14)} aria-label={m.name}>{m.text}</li>;
      const w = m.h * ASPECT[m.key];
      return <li class="abs logo" style={pos(cx - w / 2, y(cy) - m.h / 2, w, m.h)} aria-label={m.name} set:html={m.svg} />;
    })}
  </ul>
</section>

<style>
  .globe-live { display: none; position: absolute; inset: 0; width: 100%; height: 100%; }
  .globe.is-live .globe-live { display: block; }
  .globe.is-live .globe-static { display: none; }
  .logo :global(svg) { width: 100%; height: 100%; display: block; }
  .leaders { filter: drop-shadow(0 0 calc(7.1 * var(--u)) rgb(255 255 255 / 0.6)); }
  .company { font-size: calc(10 * var(--u)); line-height: calc(14 * var(--u)); letter-spacing: calc(2 * var(--u)); font-weight: 700; }
</style>
