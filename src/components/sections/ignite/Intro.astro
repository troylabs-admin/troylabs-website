---
/**
 * Ignite › Intro paragraph between the ∘∘∘ dividers — Section y 560–740 du (2026-08-23 update:
 * text rewrapped to 6990:1000 @291,599 419×42, dot rows added like DEMO's).
 * Figma: dot groups 7102:3934 @477,574 and 7102:3939 @477,664 (x 477/499/521).
 */
import { pos } from '../../../lib/units';
import Stars from '../../space/Stars.astro';

const TOP = 560;
const dots = [477, 499, 521].flatMap((x) => [{ x, y: 574 - TOP, kind: 'dot' }, { x, y: 664 - TOP, kind: 'dot' }]) as any;
---

<section class="section" style="--h:180" data-figma="IgniteIntro">
  <Stars items={dots} />
  <p class="abs m-0 t-nav text-center" style={pos(291, 599 - TOP, 419, 42)}>
    Our general membership program that is open to all students. Expand your network, develop core founder skills, and engage with the startup community on a timeline that fits your schedule.
  </p>
</section>

<!-- mobile -->
<div class="m m-iintro m-pad m-stack" data-m="IgniteIntro">
  <span class="m-dots" aria-hidden="true"><i /><i /><i /></span>
  <p class="m-0 t-nav m-center normal-case" style="max-width:330px;text-transform:none">
    Our general membership program that is open to all students. Expand your network, develop core founder skills, and engage with the startup community on a timeline that fits your schedule.
  </p>
  <span class="m-dots" aria-hidden="true"><i /><i /><i /></span>
</div>

<style is:global>
  @media (max-width: 767px) {
    .m-iintro { padding-block: 4px 30px; gap: 18px; }
    .m-iintro .m-dots { display: flex; gap: 18px; }
    .m-iintro .m-dots i { width: 4px; height: 4px; border-radius: 999px; background: #fff; box-shadow: 0 0 7px rgb(255 255 255 / 0.7); }
    .m-iintro p { font-size: 12px; line-height: 19px; letter-spacing: 0.6px; }
  }
</style>
