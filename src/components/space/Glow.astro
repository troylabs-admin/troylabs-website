---
/**
 * Soft ambient glow — Figma: blurred VECTOR ellipse (fill color@alpha, LAYER_BLUR radius).
 * e.g. "Ellipse 247" 700×925 du, #ff7d2c @ 10%, blur 156.5, rotated 2.7°.
 * PERF (2026-08-24): one radial-gradient on a box padded by the blur's bleed — no filter surface
 * (Safari re-rasterized the old blur() on scroll) and no fill/shadow seam (the two-part version left a
 * faint ring where they met). The stop ramp approximates the gaussian: plateau at α, 0.5α at the
 * original ellipse edge, easing to 0. `pad` exists because a padded box GROWS the page when a glow sits
 * at the page bottom (scrollable overflow) — the home board glow passes pad={0}; at its 5% alpha the
 * unpadded edge is imperceptible.
 */
import { pos } from '../../lib/units';
interface Props { x: number; y: number; w: number; h: number; color?: string; alpha?: number; blur?: number; rotate?: number; pad?: number }
const { x, y, w, h, color = 'var(--color-orange)', alpha = 0.05, blur = 156.5, rotate = 0, pad = blur } = Astro.props;

const mix = (a: number) => `color-mix(in srgb, ${color} ${(alpha * a * 100).toFixed(2)}%, transparent)`;
/* f = where the original ellipse edge lands inside the padded box (per the tighter axis) */
const f = Math.min((w / 2) / (w / 2 + pad), (h / 2) / (h / 2 + pad));
const stop = (a: number, at: number) => `${mix(a)} ${(at * 100).toFixed(1)}%`;
const grad = `radial-gradient(50% 50% at 50% 50%, ${[
  stop(1, 0.55 * f), stop(0.82, 0.85 * f), stop(0.5, f),
  stop(0.16, f + 0.4 * (1 - f)), stop(0.04, f + 0.72 * (1 - f)), 'transparent 100%',
].join(',')})`;
---

<div
  class="abs rounded-full pointer-events-none"
  aria-hidden="true"
  style={`${pos(x - pad, y - pad, w + 2 * pad, h + 2 * pad)};background:${grad};transform:rotate(${rotate}deg)`}
/>
