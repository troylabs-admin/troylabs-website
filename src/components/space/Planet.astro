---
/**
 * Planet — the designer's rendered planet PNGs (orange / yellow / blue-with-ring / moon),
 * placed by their Figma box. Kept as one component so later animation hooks live in one place.
 *   orange: Figma "Ellipse 6" 300×300 (#070707 + orange inner shadows + contour rings)
 *   yellow: "Ellipse 7" 300×300 · blue: "Group 39628" 456.6×300 (planet + orbit ring) · moon: "Ellipse 9" 32×32
 */
import { Image } from 'astro:assets';
import { pos } from '../../lib/units';
import orange from '../../assets/space/orange-planet.png';
import yellow from '../../assets/space/yellow-planet.png';
import blue from '../../assets/space/blue-planet.png';
import moon from '../../assets/space/moon.png';

type Kind = 'orange' | 'yellow' | 'blue' | 'moon';
interface Props { kind: Kind; x: number; y: number; w: number; h?: number; class?: string }
const { kind, x, y, w, h = w, class: cls } = Astro.props;

const src = { orange, yellow, blue, moon }[kind];
// mouse-parallax depth (px at the viewport edge) and breathing period — different per body so they never sync
const DEPTH = { orange: 14, yellow: 18, blue: 10, moon: 26 };
const PERIOD = { orange: '14s', yellow: '19s', blue: '11s', moon: '9s' };
// moon.png carries a glow halo: the solid disc is 73.5% of the png (measured), so enlarge the box around the design box.
const halo = kind === 'moon' ? 1 / 0.735 : 1;
const bw = w * halo, bh = h * halo, ox = (bw - w) / 2, oy = (bh - h) / 2;
---

<!-- three nested transforms: .planet = scroll drift · .parallax = mouse depth · img = breathing -->
<div class:list={['abs planet pointer-events-none select-none', cls]} style={pos(x - ox, y - oy, bw, bh)} data-planet={kind}>
  <span class="atmo" aria-hidden="true" style={`--p:${PERIOD[kind]}`} />
  <div class="parallax" data-depth={DEPTH[kind]}>
    <Image src={src} alt="" aria-hidden="true" widths={[480, 960, 1440]} sizes={`${Math.round(bw * 1.44)}px`} class="breathe" style="width:100%;height:100%" data-period={PERIOD[kind]} />
  </div>
</div>
