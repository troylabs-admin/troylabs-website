---
/**
 * Pill CTA — Figma "Frame 155" (IGNITE 6997:1305 "APPLY TO IGNITE", BUILD 6997:1298 "APPLY TO BUILD").
 *   215.6×33.6 du, radius 100, fill #1a1a1a@0, 0.3 white inside stroke, inner shadow white@40% blur 13.6,
 *   padding 5/12, label 20px/23 ls1.6 centered (.t-title).
 */
import { pos } from '../../lib/units';
interface Props { label: string; href?: string; x: number; y: number; w: number; h: number }
const { label, href = '/apply', x, y, w, h } = Astro.props;
---

<a href={href} class="abs pill t-title flex items-center justify-center whitespace-nowrap no-underline text-ink" style={pos(x, y, w, h)}>{label}</a>

<style>
  .pill {
    border-radius: 9999px;
    /* 6997:1305: 0.3 du white INSIDE stroke (as an inset spread shadow — Chrome snaps sub-px borders to 1px)
       + inner shadow white@40% blur 13.6 */
    box-shadow: inset 0 0 0 calc(0.3 * var(--u)) #fff, inset 0 0 calc(13.6 * var(--u)) rgb(255 255 255 / 0.4);
    transition: box-shadow 150ms ease;
  }
  .pill:hover, .pill:focus-visible { box-shadow: inset 0 0 0 calc(0.3 * var(--u)) #fff, inset 0 0 calc(13.6 * var(--u)) rgb(255 255 255 / 0.6); }
</style>
