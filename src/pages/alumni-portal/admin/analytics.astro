---
/** Alumni portal › Admin › Analytics (the MVP's /admin/analytics). DESIGN PREVIEW: numbers are placeholders. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/portal.css';
import PortalShell from '../../../components/portal/PortalShell.astro';
import AdminNav from '../../../components/portal/AdminNav.astro';
const TILES = [['ALUMNI SIGNED UP', '13', 'accounts in the portal'], ['ACTIVE THIS MONTH', '1', 'signed in within 30 days · goal: 40% of members'], ['DIRECTORY FILLED IN', '92%', 'average profile completeness · goal: 70%+'], ['SEARCHES TODAY', '2', 'people looking for people'], ['TEXTS SENT THIS MONTH', '0', 'goal: 95%+ delivered']];
---

<BaseLayout nav="portal" current="admin" title="Analytics — TL Alumni Network Portal" description="TroyLabs alumni portal analytics.">
  <PortalShell label="Analytics">
    <AdminNav current="analytics" />
    <div class="portal-page-head">
      <div><h1 class="t-title portal-page-title">ANALYTICS</h1><p class="t-caption text-muted portal-page-sub">Last updated 8:14 AM</p></div>
      <div class="portal-actions"><button type="button" class="portal-btn is-small is-quiet t-label" data-action="refresh" data-done="REFRESHED" data-feedback="Live numbers arrive once the database is connected." data-feedback-target="#an-fb">REFRESH</button></div>
    </div>
    <p id="an-fb" class="t-fine portal-feedback" style="text-align:right"></p>
    <div class="portal-tiles portal-tiles-3">{TILES.map(([l, v, t]) => <div class="portal-panel portal-tile"><span class="t-label text-muted">{l}</span><span class="t-stat">{v}</span><span class="t-fine text-muted">{t}</span></div>)}</div>
  </PortalShell>
</BaseLayout>
