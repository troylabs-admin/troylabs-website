---
/**
 * Admin › Analytics (2026-10-02). Two things, clearly separated, the website first (Bryan): the TROYLABS WEBSITE (who
 * visits usctroylabs.com, from PostHog, counts only) and the ALUMNI NETWORK (who is in it, from our database, and how
 * the portal is used, from PostHog). A status line says whether PostHog is connected and when the numbers were
 * fetched; 7 / 30 / 90 days. Filled by scripts/portal-admin-stats.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/portal.css';
import PortalShell from '../../../components/portal/PortalShell.astro';
import AdminNav from '../../../components/portal/AdminNav.astro';
const WEBSITE: [string, string, string][] = [
  ['PAGE VIEWS', 'every page of usctroylabs.com', 'site:$pageview'],
  ['APPLY CLICKS', 'any "Apply to TroyLabs" button', 'site:apply_click'],
  ['VIDEO PLAYS', 'the DEMO reel and other videos', 'site:video_play'],
  ['LINKS OFF THE SITE', 'Instagram, LinkedIn, Substack…', 'site:outbound_click'],
  ['EMAIL CLICKS', 'troylabs@usc.edu links', 'site:email_click'],
  ['TO THE PORTAL', 'clicks into the alumni portal', 'site:portal_click'],
];
const NETWORK: [string, string, string][] = [
  ['MEMBERS', 'everyone approved', 'members'],
  ['CURRENT STUDENTS', 'status: student', 'students'],
  ['ALUMNI', 'status: alum', 'alumni'],
  ['WAITING FOR APPROVAL', 'finished sign-ups', 'pending'],
  ['ACTIVE MEMBERS', 'opened the portal in 30 days', 'active30'],
  ['PROFILES FILLED IN', 'average completeness', 'completeness'],
];
const USAGE: [string, string, string][] = [
  ['SIGN-INS', 'magic links opened', 'site:portal_signin'],
  ['SEARCHES', 'in the network', 'site:search_run'],
  ['GLOBE TAPS', 'places looked at', 'site:globe_star_tap'],
];
---

<BaseLayout nav="portal" current="admin" title="Analytics — TL Alumni Network Portal" description="TroyLabs website and alumni network analytics.">
  <PortalShell label="Numbers">
    <AdminNav current="analytics" />
    <div class="portal-page-head">
      <div><h1 class="t-title portal-page-title">ANALYTICS</h1><p class="t-caption text-muted portal-page-sub">The TroyLabs website, then the alumni network. Counts only: nobody is identified or followed around.</p></div>
      <div class="portal-actions">
        <div class="flex flex-wrap portal-chips" data-single data-days role="group" aria-label="Period"><button type="button" class="t-fine portal-chip" aria-pressed="false" data-value="7">7 DAYS</button><button type="button" class="t-fine portal-chip" aria-pressed="true" data-value="30">30 DAYS</button><button type="button" class="t-fine portal-chip" aria-pressed="false" data-value="90">90 DAYS</button></div>
        <button type="button" class="portal-btn is-small is-quiet t-label" data-action="refresh">REFRESH</button>
      </div>
    </div>
    <p class="t-fine portal-delivery" data-site-status role="status">Checking PostHog…</p>

    <div class="portal-source portal-source-site"><span class="t-fine portal-role portal-role-blue">TROYLABS WEBSITE</span><h2 class="t-sub m-0">Who visits usctroylabs.com</h2><span class="t-fine text-muted">PostHog · <span data-period>last 30 days</span></span></div>
    <div class="portal-tiles portal-tiles-3" style="margin-top:0">{WEBSITE.map(([l, t, key]) => <div class="portal-panel portal-tile"><span class="t-label text-muted">{l}</span><span class="t-stat" data-stat={key}>—</span><span class="t-fine text-muted">{t}</span></div>)}</div>
    <div class="portal-panels portal-panels-2">
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">Most visited pages</h3><ul class="portal-row-list t-caption" data-list="pages"><li class="text-muted">—</li></ul></div>
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">By device</h3><ul class="portal-row-list t-caption" data-list="devices"><li class="text-muted">—</li></ul></div>
    </div>

    <div class="portal-source"><span class="t-fine portal-role">ALUMNI NETWORK</span><h2 class="t-sub m-0">Who's in it</h2><span class="t-fine text-muted">our database, right now</span></div>
    <div class="portal-tiles portal-tiles-3" style="margin-top:0">{NETWORK.map(([l, t, key]) => <div class="portal-panel portal-tile"><span class="t-label text-muted">{l}</span><span class="t-stat" data-stat={key}>—</span><span class="t-fine text-muted">{t}</span></div>)}</div>
    <div class="portal-panels portal-panels-2">
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">Members by cohort</h3><ul class="portal-row-list t-caption" data-list="byCohort"><li class="text-muted">—</li></ul></div>
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">Members by city</h3><ul class="portal-row-list t-caption" data-list="byCity"><li class="text-muted">—</li></ul></div>
    </div>

    <div class="portal-source"><span class="t-fine portal-role">ALUMNI NETWORK</span><h2 class="t-sub m-0">How the portal is used</h2><span class="t-fine text-muted">PostHog · <span data-period>last 30 days</span></span></div>
    <div class="portal-tiles portal-tiles-3" style="margin-top:0">{USAGE.map(([l, t, key]) => <div class="portal-panel portal-tile"><span class="t-label text-muted">{l}</span><span class="t-stat" data-stat={key}>—</span><span class="t-fine text-muted">{t}</span></div>)}</div>
    <div class="portal-panels portal-panels-2">
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">Portal pages opened</h3><ul class="portal-row-list t-caption" data-list="portalPages"><li class="text-muted">—</li></ul></div>
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">About these numbers</h3><ul class="portal-panel-list t-caption text-muted"><li><span class="text-ink">Members</span> are counted from the profiles in our database the moment you open this page.</li><li><span class="text-ink">Everything else</span> is PostHog event counts for the period you pick. No cookies and no personal profiles, so there are no "unique visitors": page views is the honest number.</li><li><span class="text-ink">Searches</span> are counted, never what was typed.</li></ul></div>
    </div>
  </PortalShell>
</BaseLayout>
<script src="../../../scripts/portal-admin-stats.ts"></script>
