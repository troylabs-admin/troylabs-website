---
/**
 * Admin › Analytics. Two things, clearly separated (Bryan, 2026-09-15): the ALUMNI NETWORK (who is in it,
 * from our database) and the TROYLABS WEBSITE (who visits usctroylabs.com, from Vercel Analytics for
 * from PostHog, counts only). Filled by scripts/portal-admin-stats.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/portal.css';
import PortalShell from '../../../components/portal/PortalShell.astro';
import AdminNav from '../../../components/portal/AdminNav.astro';
const NETWORK: [string, string, string, string][] = [
  ['TOTAL MEMBERS', '—', 'everyone approved', 'members'],
  ['CURRENT STUDENTS', '—', 'status: student', 'students'],
  ['ALUMNI', '—', 'status: alum', 'alumni'],
  ['PROFILES FILLED IN', '—', 'average completeness', 'completeness'],
  ['ACTIVE THIS MONTH', '—', 'signed in within 30 days', 'active30'],
  ['ACCESS REQUESTS WAITING', '—', 'on the Members page', 'pending'],
];

const WEBSITE: [string, string, string, string][] = [
  ['PAGE VIEWS', '—', 'usctroylabs.com, last 30 days', 'site:$pageview'],
  ['APPLY CLICKS', '—', 'any "Apply to TroyLabs" button', 'site:apply_click'],
  ['LINKS OFF THE SITE', '—', 'Instagram, LinkedIn, Substack…', 'site:outbound_click'],
  ['PORTAL SIGN-INS', '—', 'magic links opened', 'site:portal_signin'],
  ['SEARCHES', '—', 'in the alumni network', 'site:search_run'],
  ['GLOBE STAR TAPS', '—', 'places looked at on the map', 'site:globe_star_tap'],
];

---

<BaseLayout nav="portal" current="admin" title="Analytics — TL Alumni Network Portal" description="TroyLabs alumni network and website analytics.">
  <PortalShell label="Numbers">
    <AdminNav current="analytics" />
    <div class="portal-page-head">
      <div><h1 class="t-title portal-page-title">ANALYTICS</h1><p class="t-caption text-muted portal-page-sub">Two different things. The alumni network is who's in it. The TroyLabs website is who visits it.</p></div>
      <div class="portal-actions"><button type="button" class="portal-btn is-small is-quiet t-label" data-action="refresh" data-done="REFRESHED">REFRESH</button></div>
    </div>
    <p id="an-fb" class="t-fine portal-feedback" style="text-align:right"></p>

    <div class="portal-source"><span class="t-fine portal-role">ALUMNI NETWORK</span><h2 class="t-sub m-0">Who's in the network</h2><span class="t-fine text-muted">from our database</span></div>
    <div class="portal-tiles portal-tiles-3" style="margin-top:0">{NETWORK.map(([l, v, t, key]) => <div class="portal-panel portal-tile"><span class="t-label text-muted">{l}</span><span class="t-stat" data-stat={key}>{v}</span><span class="t-fine text-muted">{t}</span></div>)}</div>
    <div class="portal-panels portal-panels-2">
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">Members by cohort</h3><ul class="portal-row-list t-caption" data-list="byCohort"><li class="text-muted">—</li></ul></div>
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">Members by city</h3><ul class="portal-row-list t-caption" data-list="byCity"><li class="text-muted">—</li></ul></div>
    </div>

    <div class="portal-source portal-source-site"><span class="t-fine portal-role portal-role-blue">TROYLABS WEBSITE</span><h2 class="t-sub m-0">Who visits usctroylabs.com</h2><span class="t-fine text-muted" data-site-source>from PostHog · counts only, nobody is tracked</span></div>
    <div class="portal-tiles portal-tiles-3" style="margin-top:0">{WEBSITE.map(([l, v, t, key]) => <div class="portal-panel portal-tile"><span class="t-label text-muted">{l}</span><span class="t-stat" data-stat={key}>{v}</span><span class="t-fine text-muted">{t}</span></div>)}</div>
    <div class="portal-panels portal-panels-2">
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">Most visited pages</h3><ul class="portal-row-list t-caption" data-list="pages"><li class="text-muted">—</li></ul></div>
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">Where each number comes from</h3><ul class="portal-panel-list t-caption text-muted"><li><span class="text-ink">The network</span> — counted from the profiles in our database, right now.</li><li><span class="text-ink">The website</span> — PostHog event counts for the last 30 days: page views, clicks, searches, taps. No cookies, no person is ever identified, so there is no “unique visitors”; page views is the honest number.</li><li><span class="text-ink">By device</span> — <span data-devices>—</span></li></ul></div>
    </div>
  </PortalShell>
</BaseLayout>
<script src="../../../scripts/portal-admin-stats.ts"></script>
