---
/**
 * Admin › Numbers. Two different things, kept apart (Bryan, 2026-09-15): the NETWORK (who is in it —
 * comes from the database) and the WEBSITE (who visits it — comes from Vercel Analytics, already
 * installed; PostHog can be added later for click-level detail). DESIGN PREVIEW: placeholder numbers.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/portal.css';
import PortalShell from '../../../components/portal/PortalShell.astro';
import AdminNav from '../../../components/portal/AdminNav.astro';
const NETWORK: [string, string, string][] = [
  ['TOTAL MEMBERS', '7', 'everyone with an account'],
  ['CURRENT STUDENTS', '4', 'status: student'],
  ['ALUMNI', '3', 'status: alum'],
  ['PROFILES FILLED IN', '71%', 'average completeness'],
  ['ACTIVE THIS MONTH', '3', 'signed in within 30 days'],
  ['ACCESS REQUESTS WAITING', '2', 'on the Members page'],
];
const COHORTS = [['FA26', 1], ['SP26', 1], ['FA25', 1], ['SP25', 4]] as const;
const CITIES = [['Los Angeles, CA', 4], ['San Francisco, CA', 1], ['New York, NY', 1], ['Seattle, WA', 1]] as const;
const WEBSITE: [string, string, string][] = [
  ['VISITORS THIS MONTH', '—', 'usctroylabs.com, unique'],
  ['PAGE VIEWS', '—', 'all pages'],
  ['APPLY CLICKS', '—', 'any "Apply to TroyLabs" button'],
  ['PORTAL SIGN-INS', '—', 'this month'],
  ['SEARCHES', '—', 'in the alumni network'],
  ['GLOBE PIN CLICKS', '—', 'people looked up on the map'],
];
const PAGES = [['/', '—'], ['/build', '—'], ['/ignite', '—'], ['/demo', '—'], ['/apply', '—'], ['/alumni-portal', '—']] as const;
---

<BaseLayout nav="portal" current="admin" title="Numbers — TL Alumni Network Portal" description="TroyLabs network and website numbers.">
  <PortalShell label="Numbers">
    <AdminNav current="analytics" />
    <div class="portal-page-head">
      <div><h1 class="t-title portal-page-title">NUMBERS</h1><p class="t-caption text-muted portal-page-sub">The network is who's in it. The website is who visits. Different questions, so they're kept apart.</p></div>
      <div class="portal-actions"><button type="button" class="portal-btn is-small is-quiet t-label" data-action="refresh" data-done="REFRESHED" data-feedback="Live numbers arrive once the database and analytics are connected." data-feedback-target="#an-fb">REFRESH</button></div>
    </div>
    <p id="an-fb" class="t-fine portal-feedback" style="text-align:right"></p>

    <h2 class="t-sub portal-section-h">The network</h2>
    <div class="portal-tiles portal-tiles-3" style="margin-top:0">{NETWORK.map(([l, v, t]) => <div class="portal-panel portal-tile"><span class="t-label text-muted">{l}</span><span class="t-stat">{v}</span><span class="t-fine text-muted">{t}</span></div>)}</div>
    <div class="portal-panels portal-panels-2">
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">Members by cohort</h3><ul class="portal-row-list t-caption">{COHORTS.map(([c, n]) => <li><span>{c}</span><span class="text-ink">{n}</span></li>)}</ul></div>
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">Members by city</h3><ul class="portal-row-list t-caption">{CITIES.map(([c, n]) => <li><span>{c}</span><span class="text-ink">{n}</span></li>)}</ul></div>
    </div>

    <h2 class="t-sub portal-section-h">The website <span class="t-fine text-muted" style="letter-spacing:calc(1.2 * var(--u))">· FROM VERCEL ANALYTICS</span></h2>
    <div class="portal-tiles portal-tiles-3" style="margin-top:0">{WEBSITE.map(([l, v, t]) => <div class="portal-panel portal-tile"><span class="t-label text-muted">{l}</span><span class="t-stat">{v}</span><span class="t-fine text-muted">{t}</span></div>)}</div>
    <div class="portal-panels portal-panels-2">
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">Most visited pages</h3><ul class="portal-row-list t-caption">{PAGES.map(([p, n]) => <li><span>{p}</span><span class="text-ink">{n}</span></li>)}</ul></div>
      <div class="portal-panel"><h3 class="t-sub portal-panel-title">What we count</h3><p class="m-0 t-caption text-muted">Page views, Apply clicks, portal sign-ins, searches (the query, never who searched), globe pin clicks, message blasts sent and delivered, access requests and approvals. Counts only — no one is tracked individually.</p></div>
    </div>
  </PortalShell>
</BaseLayout>
