---
/**
 * Alumni portal › Admin › Overview (rebuilt 2026-10-02, Bryan: "do you think this is the greatest overview?").
 * What needs you first (people to approve, email that can't reach members yet; hidden when there's nothing), then four numbers, then messages coming
 * up and just sent, then the sign-up link to share and the common jobs. Filled by scripts/portal-admin-stats.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/portal.css';
import PortalShell from '../../../components/portal/PortalShell.astro';
import AdminNav from '../../../components/portal/AdminNav.astro';
const TILES: [string, string, string][] = [
  ['MEMBERS', 'members', 'students · alumni'],
  ['NEW THIS MONTH', 'newThisMonth', 'joined the network'],
  ['ACTIVE MEMBERS', 'active30', 'opened the portal in 30 days'],
  ['WEBSITE VISITS', 'site:$pageview', 'page views, last 30 days'],
];
---

<BaseLayout nav="portal" current="admin" title="Admin — TL Alumni Network Portal" description="TroyLabs alumni portal admin.">
  <PortalShell label="Admin dashboard">
    <AdminNav current="admin" />
    <div class="portal-page-head">
      <div>
        <h1 class="t-title portal-page-title">OVERVIEW</h1>
        <p class="t-caption text-muted portal-page-sub">What needs you, and how the network is doing.</p>
      </div>
    </div>

    <!-- shown only when there's something to act on (scripts/portal-admin-stats.ts); otherwise the numbers come first -->
    <div class="portal-panel portal-attention" style="margin-top:calc(12 * var(--u))" hidden>
      <h2 class="t-sub portal-panel-title">Needs your attention</h2>
      <ul class="portal-row-list t-caption" data-attention></ul>
    </div>

    <div class="portal-tiles">{TILES.map(([l, key, hint]) => <div class="portal-panel portal-tile"><span class="t-label text-muted">{l}</span><span class="t-stat" data-stat={key}>—</span><span class="t-fine text-muted" data-stat-hint={key}>{hint}</span></div>)}</div>

    <div class="portal-panels portal-panels-2">
      <div class="portal-panel"><h2 class="t-sub portal-panel-title">Coming up</h2><ul class="portal-row-list t-caption" data-upcoming><li class="text-muted">—</li></ul></div>
      <div class="portal-panel"><h2 class="t-sub portal-panel-title">Recently sent <span class="t-fine text-muted" style="letter-spacing:calc(1 * var(--u))">· <span data-stat="sentThisMonth">—</span> this month</span></h2><ul class="portal-row-list t-caption" data-recent><li class="text-muted">—</li></ul></div>
    </div>

    <div class="portal-panels portal-panels-2">
      <div class="portal-panel"><h2 class="t-sub portal-panel-title">The sign-up link</h2>
        <p class="m-0 t-caption text-muted">Share this anywhere. People sign in with any email they check, fill in the required profile (name, divisions, the semester they joined, graduation year, any e-board roles), and wait for you on the Members page.</p>
        <div class="portal-inline" style="margin-top:calc(12 * var(--u))"><input class="t-caption portal-input" readonly value="https://usctroylabs.com/alumni-portal" aria-label="Sign-up link" data-signup-link /><button type="button" class="portal-btn is-small t-label" data-copy-link>COPY</button></div>
      </div>
      <div class="portal-panel"><h2 class="t-sub portal-panel-title">Common jobs</h2>
        <div class="portal-actions" style="flex-direction:column;align-items:stretch">
          <a class="portal-btn is-small is-quiet t-label no-underline text-ink" href="/alumni-portal/admin/messages">WRITE A MESSAGE</a>
          <a class="portal-btn is-small is-quiet t-label no-underline text-ink" href="/alumni-portal/admin/users#approvals">REVIEW SIGN-UPS</a>
          <a class="portal-btn is-small is-quiet t-label no-underline text-ink" href="/alumni-portal/admin/users#members">FIND OR EXPORT MEMBERS</a>
          <a class="portal-btn is-small is-quiet t-label no-underline text-ink" href="/alumni-portal/admin/analytics">SEE ANALYTICS</a>
        </div>
      </div>
    </div>
  </PortalShell>
</BaseLayout>
<script src="../../../scripts/portal-admin-stats.ts"></script>
