---
/** Admin SMS workspace: compose, select recipients, test, send or schedule, and inspect actual history. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/portal.css';
import '../../../styles/portal-messages.css';
import PortalShell from '../../../components/portal/PortalShell.astro';
import AdminNav from '../../../components/portal/AdminNav.astro';
import { INDUSTRIES } from '../../../lib/portal/options';
import { GROUPS } from '../../../../supabase/functions/_shared/audience';
import { APPROVED_TEXT_WITH_CARD, GOODBYE_TEXT, HELP_REPLY, STOP_REPLY, WELCOME_TEXT } from '../../../../supabase/functions/_shared/sms';
const AUTO: [string, string, string][] = [
  ['Someone is approved', 'Their first text, sent when an admin approves them, with the TroyLabs contact card attached (name and logo to save). Once per number.', APPROVED_TEXT_WITH_CARD],
  ['Someone turns texts back on', 'On their profile (or an admin does it for them), or by replying START. Sent once per number.', WELCOME_TEXT],
  ['Someone turns texts off on the website', 'On their profile, or an admin does it for them. Sent once. A STOP reply gets the next one instead.', GOODBYE_TEXT],
  ['Someone replies STOP', 'Twilio answers and blocks texts to that phone until it replies START; their profile box unticks.', STOP_REPLY],
  ['Someone replies HELP', 'Twilio answers.', HELP_REPLY],
];
const HINT: Record<string, string> = { 'E-BOARD': 'Current: an e-board role this semester. Alumni: alumni who held one in any semester.', EVERYONE: 'Current: every student. Alumni: every alum.' };
---

<BaseLayout nav="portal" current="admin" title="Messages — TL Alumni Network Portal" description="Text TroyLabs members and alumni.">
  <PortalShell label="Send text messages">
    <AdminNav current="messages" />
    <div class="portal-messaging">
    <div class="portal-page-head"><div>
      <h1 class="t-title portal-page-title">MESSAGES</h1>
      <p class="t-caption text-muted portal-page-sub">Write a text, choose groups or specific people, then test it on your own phone.</p>
      <p class="m-0 t-fine portal-delivery" id="msg-delivery" role="status">Checking text delivery…</p>
    </div></div>

    <section class="msg-library msg-drafts" aria-labelledby="msg-drafts-title"><div class="msg-library-head"><h2 id="msg-drafts-title" class="t-sub">Saved drafts</h2><span class="t-fine text-muted" data-draft-count></span></div><ul class="portal-row-list t-caption" data-draft-list><li class="text-muted">No saved drafts. Write a message below to begin.</li></ul></section>

    <div class="portal-panels portal-panels-2 msg-workspace">
      <form class="portal-panel msg-compose" novalidate>
        <div class="msg-compose-head"><div><h2 class="t-sub portal-panel-title">Compose message</h2><p class="t-fine text-muted m-0" data-compose-state>New message</p></div><button type="button" class="t-label portal-linklike" data-action="new-draft">NEW DRAFT</button></div>
        <span class="t-label text-muted">START FROM A TEMPLATE</span><div class="flex flex-wrap portal-chips" data-templates style="margin:calc(8 * var(--u)) 0 calc(14 * var(--u))"></div>
        <div class="portal-field" style="margin-top:calc(14 * var(--u))"><label class="t-label text-muted" for="mc-body">YOUR TEXT</label><textarea id="mc-body" class="t-caption portal-textarea" rows="6" placeholder="What would you like to share?"></textarea><p id="mc-sms" class="m-0 t-fine text-muted" aria-live="polite" hidden></p>
          <div class="portal-sms-preview" data-sms-preview hidden><span class="t-label text-muted">PHONE PREVIEW</span><p class="m-0 t-caption portal-sms-bubble" data-sms-bubble></p></div></div>
        <details class="portal-fold" data-fold>
          <summary class="t-label text-muted">EVENT DETAILS (OPTIONAL)</summary>
        <div class="portal-field" style="gap:calc(10 * var(--u))">
          <input id="mc-ev-name" class="t-caption portal-input is-wide" placeholder="Event name" aria-label="Event name" />
          <input id="mc-ev-when" class="t-caption portal-input is-wide" type="datetime-local" aria-label="Event date and time" />
          <input id="mc-ev-where" class="t-caption portal-input is-wide" placeholder="Location or link" aria-label="Location or link" />
          <input id="mc-ev-rsvp" class="t-caption portal-input is-wide" placeholder="RSVP URL" aria-label="RSVP URL" />
        </div>
        </details>
        <div class="msg-compose-actions"><button type="button" class="portal-btn is-small is-quiet t-label" data-action="draft" data-done="SAVED">SAVE DRAFT</button></div>
      </form>
      <div class="portal-panel msg-audience">
        <div class="msg-compose-head"><h2 class="t-sub portal-panel-title">Recipients</h2><button type="button" class="t-label portal-linklike" data-action="clear-audience">CLEAR</button></div>
        <div class="portal-chips msg-audience-modes" data-react-controls><button type="button" class="t-fine portal-chip" aria-pressed="true" data-audience-mode="groups">GROUPS</button><button type="button" class="t-fine portal-chip" aria-pressed="false" data-audience-mode="people">SPECIFIC PEOPLE</button></div>
        <div data-groups-panel>
        <p class="m-0 t-fine text-muted" style="margin:calc(4 * var(--u)) 0 calc(10 * var(--u))">Numbers show members in each group. Only people with a phone number and texts turned on can receive. Overlapping groups send once per phone.</p>
        <div class="portal-aud-grid" data-aud-grid role="group" aria-label="Who gets it">
          {GROUPS.map((g) => (<>
            <span class="t-label portal-aud-group" title={HINT[g]}>{g}</span>
            <button type="button" class="t-fine portal-chip portal-aud-cell" aria-pressed="false" data-group={g} data-who="current" aria-label={`${g}, current`}>CURRENT <span class="text-muted" data-n></span></button>
            <button type="button" class="t-fine portal-chip portal-aud-cell" aria-pressed="false" data-group={g} data-who="alumni" aria-label={`${g}, alumni`}>ALUMNI <span class="text-muted" data-n></span></button>
          </>))}
        </div>
        <details class="portal-fold portal-or" data-fold>
          <summary class="t-label text-muted">FILTER GROUPS (OPTIONAL)</summary>
          <p class="m-0 t-fine text-muted" style="margin:calc(2 * var(--u)) 0 calc(10 * var(--u))">Narrow the groups above by cohort or industry. If you choose both, people must match both filters.</p>
          <span class="t-label text-muted">COHORT</span><div class="flex flex-wrap portal-chips" data-cohorts style="margin:calc(8 * var(--u)) 0 calc(14 * var(--u))"></div>
          <span class="t-label text-muted">INDUSTRIES</span><div class="flex flex-wrap portal-chips" data-aud-industries style="margin:calc(8 * var(--u)) 0 calc(14 * var(--u))">{INDUSTRIES.map((c) => <button type="button" class="t-fine portal-chip" aria-pressed="false" data-value={c}>{c}</button>)}</div>
        </details>
        </div>
        <div data-people-panel hidden>
          <label class="t-fine text-muted" for="mc-person-search">Find members by name or phone</label>
          <input id="mc-person-search" type="search" class="portal-input t-caption is-wide" placeholder="Search members…" autocomplete="off" />
          <div class="msg-people-tools"><span class="t-fine text-muted" data-people-count></span><button type="button" class="t-fine portal-linklike" data-action="select-people">SELECT ALL MATCHING</button></div>
          <div class="msg-people-list" data-people-list></div><div class="msg-list-footer"><span class="t-fine text-muted" data-people-visible></span><button type="button" class="portal-btn is-small is-quiet t-label" data-action="more-people" hidden>SEE MORE</button></div>
        </div>
        <div class="msg-audience-total"><p class="t-caption m-0" data-aud-summary role="status"></p><p class="t-fine text-muted m-0" data-aud-description></p></div>
        <details class="portal-fold msg-review" data-who-list hidden>
          <summary class="t-label" data-who-head>Review recipients</summary>
          <div class="msg-review-content"><label class="t-fine text-muted" for="mc-review-search">Verify a recipient by name or phone</label><input id="mc-review-search" type="search" class="portal-input t-caption is-wide" placeholder="Search selected recipients…" autocomplete="off" />
          <ul class="portal-row-list t-caption msg-recipient-list" data-who-items></ul>
          <div class="msg-list-footer"><span class="t-fine text-muted" data-review-visible></span><button type="button" class="portal-btn is-small is-quiet t-label" data-action="more-recipients" hidden>SEE MORE</button></div>
          <div data-who-excluded></div></div>
        </details>
      </div>
    </div>

    <section class="portal-panel msg-delivery-panel" aria-label="Test and send">
      <div class="msg-self-test">
        <h2 class="t-sub portal-panel-title">Test on your phone</h2>
        <p class="t-fine text-muted m-0">A test goes only to the admin signed in, regardless of the recipients selected.</p>
        <p class="t-caption msg-test-target" data-test-target role="status">Loading your phone…</p>
        <a href="/alumni-portal/profile" class="t-fine portal-inline-link">Update your phone</a>
        <button type="button" class="portal-btn is-small is-quiet t-label" data-action="test-send">SEND A TEST TO ME</button>
      </div>
      <div class="msg-send-controls">
        <h2 class="t-sub portal-panel-title">Send text messages</h2>
        <p class="t-caption msg-send-summary" data-send-summary role="status">Choose an audience above.</p>
        <span class="t-label text-muted">WHEN</span>
        <div class="flex flex-wrap portal-chips" data-single data-when><button type="button" class="t-fine portal-chip" aria-pressed="true" data-value="now">SEND NOW</button><button type="button" class="t-fine portal-chip" aria-pressed="false" data-value="later">SCHEDULE</button></div>
        <div class="msg-schedule-builder" data-when-at hidden>
          <div class="portal-field"><label for="mc-when" class="t-fine text-muted" data-timezone>First send date and time</label><input id="mc-when" type="datetime-local" class="t-caption portal-input is-wide" aria-label="Send at" /></div>
          <div class="portal-field"><label for="mc-repeat" class="t-caption">Repeat</label><select id="mc-repeat" class="portal-input portal-select t-caption is-wide"><option value="once">Does not repeat</option><option value="daily">Every day</option><option value="weekly">Every week</option><option value="monthly">Every month</option><option value="yearly">Every year</option><option value="custom">Custom…</option></select></div>
          <div data-repeat-options hidden>
            <div class="msg-repeat-custom" data-repeat-custom hidden><label for="mc-interval" class="t-caption">Every</label><input id="mc-interval" type="number" min="1" max="999" value="1" class="portal-input t-caption" aria-label="Repeat interval" /><select id="mc-frequency" class="portal-input portal-select t-caption" aria-label="Repeat unit"><option value="daily">days</option><option value="weekly">weeks</option><option value="monthly">months</option><option value="yearly">years</option></select></div>
            <fieldset class="msg-weekdays" data-repeat-weekdays hidden><legend class="t-fine text-muted">Repeat on</legend>{['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map((day,i)=><label><input type="checkbox" data-weekday={i} aria-label={['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][i]} /><span>{day}</span></label>)}</fieldset>
            <div class="portal-field"><label for="mc-repeat-end" class="t-caption">Ends</label><select id="mc-repeat-end" class="portal-input portal-select t-caption is-wide"><option value="never">Never</option><option value="until">On a date</option><option value="count">After a number of sends</option></select></div>
            <div class="portal-field" data-repeat-count-field hidden><label for="mc-repeat-count" class="t-fine text-muted">Number of sends, including the first</label><input id="mc-repeat-count" type="number" min="1" max="10000" value="5" class="portal-input t-caption is-wide" /></div>
            <div class="portal-field" data-repeat-until-field hidden><label for="mc-repeat-until" class="t-fine text-muted">Last send date</label><input id="mc-repeat-until" type="date" class="portal-input t-caption is-wide" /></div>
          </div>
          <p class="t-fine msg-schedule-description m-0" data-schedule-description role="status"></p>
        </div>
        <button type="button" class="portal-btn t-title" data-action="send" data-send-btn>SEND NOW</button>
      </div>
      <p id="msg-fb" class="t-caption portal-feedback" role="status" tabindex="-1"></p>
    </section>

    <section class="msg-library msg-scheduled" aria-labelledby="msg-scheduled-title"><div class="msg-library-head"><h2 id="msg-scheduled-title" class="t-sub">Scheduled messages</h2><span class="t-fine text-muted" data-scheduled-count></span></div><p class="t-fine text-muted">Upcoming one-time messages and repeating schedules. Dates show when the next text goes out.</p><ul class="portal-row-list t-caption" data-scheduled-list><li class="text-muted">No scheduled messages. Choose Schedule when your text is ready.</li></ul></section>

    <!-- the texts the system sends by itself, word for word (2026-10-06), and who won't get texts: members who turned
         them off or have no number (2026-10-08, replacing the one-time welcome send) -->
    <details class="portal-fold msg-automatic"><summary class="t-label text-muted">AUTOMATIC TEXTS &amp; OPT-IN REPLIES</summary>
    <p class="portal-section-sub t-fine text-muted">Sent by themselves, word for word. Every text starts with "TroyLabs:" so people know who it's from.</p>
    <ul class="portal-row-list t-caption portal-auto" data-auto-texts>
      {AUTO.map(([when, how, text]) => <li><span class="portal-auto-when"><span class="text-ink">{when}</span><br /><span class="t-fine text-muted">{how}</span></span><span class="portal-sms-bubble t-fine">{text}</span></li>)}
      <li data-texts-off hidden><span class="portal-auto-when"><span class="text-ink">Members with texts off</span><br /><span class="t-fine text-muted" data-texts-off-note></span></span><span class="portal-inline"><button type="button" class="t-label portal-linklike" data-texts-off-who>SEE WHO</button></span></li>
    </ul>
    <ul class="portal-row-list t-fine portal-who-items" data-texts-off-list hidden></ul>
    </details>

    <section class="msg-library" aria-labelledby="msg-history-title"><h2 id="msg-history-title" class="t-sub portal-section-h">Sent messages</h2><p class="t-fine text-muted">Actual sends and delivery results. Each recurring send appears separately.</p><ul class="portal-row-list t-caption" data-msg-list><li class="text-muted" data-msg-empty>No messages have been sent yet.</li></ul></section>
    </div>
  </PortalShell>
</BaseLayout>
<script src="../../../scripts/portal-messages.ts"></script>
