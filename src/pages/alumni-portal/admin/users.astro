---
/**
 * Admin › Members. The club's history and reach in one table (Bryan, 2026-09-15): filter by cohort,
 * status, division, city; free-text search; set e-board roles per member;
 * approve people who signed up (the waiting list); export. Everything comes from and goes to the database (scripts/portal-members.ts).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/portal.css';
import '../../../styles/portal-members.css';
import PortalShell from '../../../components/portal/PortalShell.astro';
import AdminNav from '../../../components/portal/AdminNav.astro';
import { DIVISIONS_SHORT as DIVISIONS, EBOARD_ROLES as EBOARD } from '../../../lib/portal/options';
const COHORTS: string[] = [];   // filled from members' data by scripts/portal-members.ts
type M = { name: string; email: string; role: string; status: 'STUDENT' | 'ALUM'; cohort: string; program: string; division: string; city: string; complete: boolean };
const MEMBERS: M[] = [];
const REQUESTS: { name: string; email: string; cohort: string; note: string }[] = [];
---

<BaseLayout nav="portal" current="admin" title="Members — TL Alumni Network Portal" description="TroyLabs alumni portal member management.">
  <PortalShell label="Members">
    <AdminNav current="users" />
    <div class="portal-member-admin">
    <div class="portal-page-head">
      <div>
        <h1 class="t-title portal-page-title">MEMBERS</h1>
        <p class="t-caption text-muted portal-page-sub">Approve the people waiting to get in, then find anyone in the network: filter, set e-board roles, export.</p>
      </div>
      <div class="portal-actions">
        <button type="button" class="portal-btn is-small is-quiet t-label" data-action="export" data-done="EXPORTING…">EXPORT CSV</button>
      </div>
    </div>
    <p id="members-fb" class="t-fine portal-feedback" style="text-align:right"></p>

    <!-- the sign-up queue (Bryan, 2026-09-30; at scale 2026-10-02): everyone gets the site link, signs up, fills in
         the required profile, and leadership approves them here. Built for a hundred at once: compact rows, search,
         sort, select all + bulk approve / decline with UNDO, 25 at a time. Filled by scripts/portal-members.ts. -->
    <div class="portal-panel" style="margin-top:calc(12 * var(--u))" id="approvals">
      <h2 class="t-sub portal-panel-title">Waiting for approval <span class="t-fine portal-role" id="requests-n">0</span></h2>
      <p class="m-0 t-fine text-muted" style="margin-bottom:calc(14 * var(--u))">Review submitted applications, then approve people to give them access to the network.</p>
      <div class="portal-q-tools" data-q-tools hidden>
        <input id="q-search" type="search" class="t-caption portal-input" placeholder="Search name, email, division, cohort…" aria-label="Search the waiting list" />
        <select id="q-sort" class="t-caption portal-input portal-select" aria-label="Sort the waiting list"><option value="oldest">Oldest first</option><option value="newest">Newest first</option><option value="name">Name A–Z</option></select>
      </div>
      <div class="portal-q-bar" data-q-bar hidden>
        <button type="button" class="portal-btn is-small is-quiet t-label" data-q-everyone>SELECT ALL</button>
        <label class="portal-check t-caption"><input type="checkbox" id="q-all" /><i></i><span data-q-all-label>Select shown</span></label>
        <button type="button" class="t-label portal-linklike" data-q-clear hidden>CLEAR SELECTION</button>
        <span class="t-fine text-muted" data-q-selected>0 selected</span>
        <div class="portal-q-bulk">
        <button type="button" class="portal-btn is-small t-label" data-q-approve disabled>APPROVE SELECTED</button>
        <button type="button" class="portal-btn is-small is-quiet t-label" data-q-decline disabled>DECLINE SELECTED</button>
        </div>
      </div>
      <div class="t-caption portal-queue-feedback" id="q-fb" role="status" tabindex="-1" hidden></div>
      <ul class="m-0 p-0 list-none portal-requests" id="requests-list"><li class="t-caption text-muted">Loading…</li></ul>
      <div class="portal-inline" style="justify-content:center;margin-top:calc(12 * var(--u))"><button type="button" class="portal-btn is-small is-quiet t-label" data-q-more hidden>SHOW MORE</button></div>
      <details class="portal-fold portal-declined" id="declined-fold" hidden>
        <summary class="t-label text-muted"><span>DECLINED <span class="t-fine portal-role portal-declined-n" id="declined-n">0</span></span></summary>
        <ul class="portal-row-list t-caption" id="declined-list"></ul>
      </details>
    </div>

    <!-- filters + search: all client-side on the placeholder rows -->
    <div class="portal-panel" style="margin-top:calc(14 * var(--u))" data-members-filters id="members">
      <div class="portal-inline"><svg class="portal-search-glyph" style="position:static;flex:none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg><input id="members-q" type="search" class="t-caption portal-input" placeholder="Search name, email, company, city…" aria-label="Search members" /></div>
      <div class="portal-filter-row" style="margin-top:calc(14 * var(--u))"><span class="t-fine text-muted portal-filter-label">STATUS</span><div class="flex flex-wrap portal-chips" data-filter="status">{['STUDENT', 'ALUM'].map((c) => <button type="button" class="t-fine portal-chip" aria-pressed="false" data-value={c}>{c}</button>)}</div></div>
      <div class="portal-filter-row" style="margin-top:calc(10 * var(--u))"><span class="t-fine text-muted portal-filter-label">COHORT</span><div class="flex flex-wrap portal-chips" data-filter="cohort">{COHORTS.map((c) => <button type="button" class="t-fine portal-chip" aria-pressed="false" data-value={c}>{c}</button>)}</div></div>
      <div class="portal-filter-row" style="margin-top:calc(10 * var(--u))"><span class="t-fine text-muted portal-filter-label">DIVISION</span><div class="flex flex-wrap portal-chips" data-filter="division">{DIVISIONS.map((c) => <button type="button" class="t-fine portal-chip" aria-pressed="false" data-value={c}>{c}</button>)}</div></div>
      <p class="t-fine portal-feedback" data-members-count style="margin-top:calc(12 * var(--u))"></p>
    </div>

    <!-- the table scrolls sideways inside its own box on a phone instead of pushing the page wide -->
    <div class="portal-table-wrap">
    <table class="portal-table t-caption" data-members>
      <thead><tr><th class="t-label">NAME</th><th class="t-label">STATUS</th><th class="t-label">COHORT</th><th class="t-label">DIVISION</th><th class="t-label">CITY</th><th class="m-meta"></th><th></th></tr></thead>
      <tbody>
        {MEMBERS.map((m) => <tr data-status={m.status} data-cohort={m.cohort} data-division={m.division} data-program={m.program} data-text={`${m.name} ${m.email} ${m.city} ${m.division} ${m.program}`.toLowerCase()}>
          <td class="m-name">{m.name}{m.role === 'ADMIN' && <span class="t-fine portal-role">ADMIN</span>}<span class="t-fine text-muted m-email">{m.email}</span></td><td><span class="t-fine portal-tag">{m.status}</span></td><td class="text-muted">{m.cohort}</td><td class="text-muted">{m.division}</td><td class="text-muted">{m.city}</td>
          <td style="text-align:right;white-space:nowrap"><button type="button" class="t-label portal-linklike" data-roles-for={m.name} style="margin-right:calc(16 * var(--u))">ROLES</button><button type="button" class="t-label portal-linklike" data-action="delete" data-confirm={`Remove ${m.name} (${m.email}) from the portal?`}>REMOVE</button></td>
        </tr>)}
      </tbody>
    </table>
    </div>

    <template id="roles-picker">
      <div class="portal-panel" data-roles style="margin:calc(8 * var(--u)) 0 calc(12 * var(--u))">
        <h3 class="t-sub portal-panel-title">E-board history for <span data-roles-name></span></h3>
        <p class="m-0 t-fine text-muted" style="margin-bottom:calc(12 * var(--u))">Pick each role they held, then the semester(s). This shows on their profile as set by leadership.</p>
        <div class="flex flex-wrap portal-chips" data-field="eboard">{EBOARD.map((c) => <button type="button" class="t-fine portal-chip" aria-pressed="false">{c}</button>)}</div>
        <div class="portal-role-years"></div>
        <div class="portal-inline" style="margin-top:calc(14 * var(--u))"><button type="button" class="portal-btn is-small t-label" data-action="save-roles">SAVE ROLES</button><p class="t-fine portal-feedback" style="margin:0"></p></div>
      </div>
    </template>
    </div>
  </PortalShell>
</BaseLayout>
<script src="../../../scripts/portal-members.ts"></script>
