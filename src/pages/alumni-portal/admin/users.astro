---
/** Alumni portal › Admin › User management (the MVP's /admin/users). DESIGN PREVIEW with placeholder rows. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/portal.css';
import PortalShell from '../../../components/portal/PortalShell.astro';
import AdminNav from '../../../components/portal/AdminNav.astro';
const EBOARD = ['DIRECTOR OF BUILD', 'DIRECTOR OF IGNITE', 'DIRECTOR OF COMMUNITY', 'DIRECTOR OF RECRUITMENT', 'DIRECTOR OF PMS', 'DIRECTOR OF VC/FINANCE', 'DIRECTOR OF DESIGN', 'DIRECTOR OF TECH', 'DIRECTOR OF MARKETING', 'DIRECTOR OF DEMO', 'CO-PRESIDENT'];
const USERS = [
  ['Sample Admin', 'president@usc.edu', 'ADMIN', 'TL_INTERNAL, BUILD', true],
  ['Sample Admin', 'copresident@usc.edu', 'ADMIN', 'TL_INTERNAL, IGNITE', true],
  ['Sample Alum', 'alum1@usc.edu', 'MEMBER', 'BUILD', true],
  ['Sample Alum', 'alum2@usc.edu', 'MEMBER', 'BUILD, DEMO', true],
  ['Sample Alum', 'alum3@usc.edu', 'MEMBER', 'IGNITE', false],
  ['Sample Investor', 'investor@fund.com', 'STAKEHOLDER', '', false],
];
---

<BaseLayout nav="portal" current="admin" title="Users — TL Alumni Network Portal" description="TroyLabs alumni portal user management.">
  <PortalShell label="User management">
    <AdminNav current="users" />
    <div class="portal-page-head">
      <h1 class="t-title portal-page-title">USER MANAGEMENT</h1>
      <div class="portal-actions"><button type="button" class="portal-btn is-small is-quiet t-label" data-action="export" data-done="EXPORTING…" data-feedback="The CSV downloads once the database is connected." data-feedback-target="#users-fb">EXPORT EMAILS &amp; PHONES (CSV)</button></div>
    </div>

    <p id="users-fb" class="t-fine portal-feedback" style="text-align:right"></p>
    <div class="portal-panel" style="margin-top:calc(12 * var(--u))">
      <h2 class="t-sub portal-panel-title">Allowed email domains</h2>
      <div class="portal-inline" data-adds="#domain-tags" style="margin-bottom:calc(12 * var(--u))"><input class="t-caption portal-input" placeholder="example.com" aria-label="Add domain" /><button type="button" class="portal-btn is-small t-label">ADD</button></div>
      <div id="domain-tags" class="flex flex-wrap portal-chips" data-tags>
        {['usc.edu', 'student.usc.edu', 'gmail.com'].map((d) => <span class="t-fine portal-tagx">{d} <button type="button" aria-label={`Remove ${d}`}>×</button></span>)}
      </div>
    </div>

    <table class="portal-table t-caption">
      <thead><tr><th class="t-label">NAME</th><th class="t-label">EMAIL</th><th class="t-label">ROLE</th><th class="t-label">PROGRAMS</th><th class="t-label">COMPLETE</th><th></th></tr></thead>
      <tbody>
        {USERS.map(([n, e, r, p, c]) => <tr><td>{n}</td><td class="text-muted">{e}</td><td><span class="t-fine portal-tag">{r}</span></td><td class="text-muted">{p}</td><td>{c ? '✓' : '—'}</td><td style="text-align:right;white-space:nowrap"><button type="button" class="t-label portal-linklike" data-roles-for={n} style="margin-right:calc(16 * var(--u))">ROLES</button><button type="button" class="t-label portal-linklike" data-action="delete" data-confirm={`Remove ${n} (${e}) from the portal?`}>DELETE</button></td></tr>)}
      </tbody>
    </table>
    <!-- e-board roles are a credential: only admins set them, here, per member (Bryan, 2026-09-14) -->
    <template id="roles-picker">
      <div class="portal-panel" data-roles style="margin:calc(8 * var(--u)) 0 calc(12 * var(--u))">
        <h3 class="t-sub portal-panel-title">E-board history for <span data-roles-name></span></h3>
        <p class="m-0 t-fine text-muted" style="margin-bottom:calc(12 * var(--u))">Pick each role they held, then the semester(s). This shows on their profile as set by leadership.</p>
        <div class="flex flex-wrap portal-chips" data-field="eboard">{EBOARD.map((c) => <button type="button" class="t-fine portal-chip" aria-pressed="false">{c}</button>)}</div>
        <div class="portal-role-years"></div>
        <div class="portal-inline" style="margin-top:calc(14 * var(--u))"><button type="button" class="portal-btn is-small t-label" data-action="save-roles">SAVE ROLES</button><p class="t-fine portal-feedback" style="margin:0"></p></div>
      </div>
    </template>
  </PortalShell>
</BaseLayout>
