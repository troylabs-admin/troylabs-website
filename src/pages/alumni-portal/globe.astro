---
/**
 * Alumni portal › Globe. Title, Charlotte's 3D globe, the count — in the portal shell. (The program chips
 * came off on 2026-09-15 — not needed yet, Bryan.) People are grouped into one star per city (components/portal/AlumniGlobe.tsx).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/portal.css';
import PortalShell from '../../components/portal/PortalShell.astro';
import AlumniGlobe from '../../components/portal/AlumniGlobe.tsx';
/* DESIGN PREVIEW people: deterministic, none real. Skewed the way a real roster will be — Bryan's
   "what if there are 300 alumni in San Francisco" — plus Bay Area / SoCal / East Coast neighbours close
   enough that their stars overlap at the opening zoom, so the merging and click-to-expand get exercised. */
const CITIES: [string, string, number, number, number][] = [
  ['San Francisco', 'CA', 37.7749, -122.4194, 300], ['Palo Alto', 'CA', 37.4419, -122.143, 12], ['San Jose', 'CA', 37.3382, -121.8863, 8], ['Oakland', 'CA', 37.8044, -122.2712, 6],
  ['Los Angeles', 'CA', 34.0522, -118.2437, 40], ['Irvine', 'CA', 33.6846, -117.8265, 7], ['San Diego', 'CA', 32.7157, -117.1611, 9],
  ['New York', 'NY', 40.7128, -74.006, 25], ['Boston', 'MA', 42.3601, -71.0589, 6], ['Philadelphia', 'PA', 39.9526, -75.1652, 3], ['Washington', 'DC', 38.9072, -77.0369, 5],
  ['Chicago', 'IL', 41.8781, -87.6298, 8], ['Seattle', 'WA', 47.6062, -122.3321, 10], ['Austin', 'TX', 30.2672, -97.7431, 5], ['Miami', 'FL', 25.7617, -80.1918, 4], ['Toronto', 'ON', 43.6532, -79.3832, 3],
  ['London', 'UK', 51.5074, -0.1278, 6], ['Singapore', '', 1.3521, 103.8198, 3], ['Tokyo', 'JP', 35.6762, 139.6503, 2], ['Mexico City', 'MX', 19.4326, -99.1332, 1],
];
const TITLES = ['Founder', 'Software Engineer', 'Product Manager', 'Analyst', 'Product Designer', 'Investor', 'Data Scientist', 'Marketing Lead'];
const COMPANIES = ['Startup', 'Company', 'Fund', 'Studio', 'Lab'];
const COHORTS = ['FA20', 'SP21', 'FA21', 'SP22', 'FA22', 'SP23', 'FA23', 'SP24', 'FA24', 'SP25', 'FA25', 'SP26'];
let n = 0;
const PINS = CITIES.flatMap(([city, region, lat, lng, count]) => Array.from({ length: count }, () => { n += 1; return {
  id: 'sample', full_name: `Sample Alum ${n}`, lat, lng, current_title: TITLES[n % TITLES.length], current_company: COMPANIES[n % COMPANIES.length],
  city, region, cohort: COHORTS[n % COHORTS.length], programs: n % 3 === 0 ? ['IGNITE'] : n % 7 === 0 ? ['TL INTERNAL', 'IGNITE'] : ['TL INTERNAL'],
}; }));
---

<BaseLayout nav="portal" current="globe" title="Globe — TL Alumni Network Portal" description="Where TroyLabs alumni are in the world.">
  <PortalShell label="Alumni globe">
    <div class="portal-page-head">
      <div>
        <h1 class="t-title portal-page-title">ALUMNI GLOBE</h1>
        <p class="t-caption text-muted portal-page-sub">One star per city. Bigger stars are more people. Tap a star for who's there.</p>
      </div>
    </div>
    <AlumniGlobe client:only="react" pins={PINS} />
    <p class="m-0 t-fine text-muted" style="margin-top:calc(16 * var(--u))">Search from Home for a list view of alumni.</p>
  </PortalShell>
</BaseLayout>
