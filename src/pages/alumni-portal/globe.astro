---
/**
 * Alumni portal › Globe. The MVP's page — title, program filters, Charlotte's 3D globe of alumni pins,
 * the count — in the portal shell. DESIGN PREVIEW: pins are placeholder people at real coordinates.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/portal.css';
import PortalShell from '../../components/portal/PortalShell.astro';
import AlumniGlobe from '../../components/portal/AlumniGlobe.tsx';
const PROGRAMS = ['TL INTERNAL', 'IGNITE', 'BUILD STARTUP', 'DEMO STARTUP'];
const PINS = [
  { id: 'sample', full_name: 'Sample Alum', lat: 34.0522, lng: -118.2437, current_title: 'Founder', current_company: 'Startup', city: 'Los Angeles', region: 'CA', cohort: 'SP25' },
  { id: 'sample', full_name: 'Sample Alum', lat: 37.7749, lng: -122.4194, current_title: 'Analyst', current_company: 'Company', city: 'San Francisco', region: 'CA', cohort: 'FA24' },
  { id: 'sample', full_name: 'Sample Alum', lat: 40.7128, lng: -74.006, current_title: 'Product Designer', current_company: 'Company', city: 'New York', region: 'NY', cohort: 'SP23' },
  { id: 'sample', full_name: 'Sample Alum', lat: 41.8781, lng: -87.6298, current_title: 'Senior PM', current_company: 'Company', city: 'Chicago', region: 'IL', cohort: 'FA22' },
  { id: 'sample', full_name: 'Sample Alum', lat: 47.6062, lng: -122.3321, current_title: 'Software Engineer', current_company: 'Company', city: 'Seattle', region: 'WA', cohort: 'SP24' },
  { id: 'sample', full_name: 'Sample Alum', lat: 25.7617, lng: -80.1918, current_title: 'Angel Investor', current_company: 'Fund', city: 'Miami', region: 'FL', cohort: 'FA21' },
  { id: 'sample', full_name: 'Sample Alum', lat: 51.5074, lng: -0.1278, current_title: 'Founder', current_company: 'Startup', city: 'London', region: 'UK', cohort: 'SP22' },
  { id: 'sample', full_name: 'Sample Alum', lat: 1.3521, lng: 103.8198, current_title: 'Analyst', current_company: 'Fund', city: 'Singapore', region: '', cohort: 'FA23' },
];
---

<BaseLayout nav="portal" current="globe" title="Globe — TL Alumni Network Portal" description="Where TroyLabs alumni are in the world.">
  <PortalShell label="Alumni globe">
    <div class="portal-page-head">
      <div>
        <h1 class="t-title portal-page-title">ALUMNI GLOBE</h1>
        <p class="t-caption text-muted portal-page-sub">Pins update when alumni change their location.</p>
      </div>
      <div data-audience="Showing" data-empty="Showing every program.">
        <div class="flex flex-wrap portal-chips">{PROGRAMS.map((c) => <button type="button" class="t-fine portal-chip" aria-pressed="false">{c}</button>)}</div>
        <p class="t-fine portal-feedback" style="text-align:right"></p>
      </div>
    </div>
    <AlumniGlobe client:only="react" pins={PINS} />
    <p class="m-0 t-fine text-muted" style="margin-top:calc(16 * var(--u))">Search from Home for a list view of alumni.</p>
  </PortalShell>
</BaseLayout>
