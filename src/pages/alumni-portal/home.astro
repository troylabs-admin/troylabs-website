 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/portal.css';
import PortalShell from '../../components/portal/PortalShell.astro';
import Network from '../../components/portal/Network.tsx';
---

<BaseLayout nav="portal" current="home" title="Search — TL Alumni Network Portal" description="Find TroyLabs alumni and students by name, role, industry, program or city, and see where they are in the world.">
