---
/**
 * TL Alumni Network Portal — the entrance IS the sign-in (Bryan, 2026-09-14: no separate front door).
 * Sign-in is a magic link only — no passwords, and no sign-up tab (Bryan, 2026-09-16: removed): alumni open this a few times a
 * year and would forget one every time, and every reset is a support job for whoever runs the club. You
 * enter the email on your profile, a link arrives, and the session stays alive for months. Once auth
 * exists this route serves the search home to a signed-in member instead; wired to the site's own
 * Supabase project TL_Network (scripts/portal-signin.ts); a build without the keys says so instead of pretending.
 * Inputs echo the pill CTA: 0.3 du inner stroke, inner white glow (PillButton.astro).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/portal.css';
import PortalFrame from '../../components/portal/PortalFrame.astro';
---

<BaseLayout nav="gate" title="TL Alumni Network Portal — TroyLabs" description="Sign in to the TroyLabs alumni network.">
  <PortalFrame h={640} label="Sign in to the alumni portal">
    <form id="portal-auth" class="portal-form flex flex-col items-center" novalidate>
      <span class="t-label text-muted m-center">TROYLABS MEMBERS, PAST AND PRESENT</span>
      <h1 class="m-0 t-title-tight font-normal text-center portal-h">TL ALUMNI NETWORK PORTAL</h1>
      <p class="m-0 t-caption text-center portal-gate-lead">Sign in or join with your email. It's the same button either way.</p>

      <input id="portal-email" type="email" name="email" autocomplete="email" placeholder="you@email.com" aria-label="Email" class="t-caption portal-input" required />

      <button type="submit" class="portal-btn t-title whitespace-nowrap">EMAIL ME A LINK</button>
      <p id="portal-msg" class="m-0 t-caption text-center portal-msg" role="status"></p>

      <!-- how it works, for someone who has never been here (Bryan, 2026-10-05: "how do they know if they have an account?") -->
      <ol class="portal-gate-steps" aria-label="How it works">
        <li><span class="portal-gate-n">1</span><span><b>Enter your email</b>Any email you check. New or returning, it's the same.</span></li>
        <li><span class="portal-gate-n">2</span><span><b>Tap the link we send</b>No password, ever. The link signs you in.</span></li>
        <li><span class="portal-gate-n">3</span><span><b>New here? Create your profile</b>TroyLabs leadership approves every member, and we email you when you're in.</span></li>
      </ol>
      <p class="m-0 t-fine text-muted text-center portal-hint">Questions? Email troylabs@usc.edu.</p>
    </form>
  </PortalFrame>
</BaseLayout>
<script src="../../scripts/portal-ui.ts"></script>
<script src="../../scripts/portal-signin.ts"></script>
