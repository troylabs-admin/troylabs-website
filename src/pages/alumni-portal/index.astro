---
/**
 * TL Alumni Network Portal — the entrance IS the sign-in (Bryan, 2026-09-14: no separate front door).
 * Log in with email + password, or Sign up for a one-time magic link (then set a password). Once auth
 * exists this route serves the search home to a signed-in member instead. Mirrors the MVP's auth flow; wired to the site's own Supabase project once it exists
 * (until then the form explains that, honestly, instead of pretending).
 * Inputs echo the pill CTA: 0.3 du inner stroke, inner white glow (PillButton.astro).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/portal.css';
import PortalFrame from '../../components/portal/PortalFrame.astro';
---

<BaseLayout nav="gate" title="TL Alumni Network Portal — TroyLabs" description="Sign in to the TroyLabs alumni network.">
  <PortalFrame h={540} label="Sign in to the alumni portal">
    <form id="portal-auth" class="portal-form flex flex-col items-center" novalidate data-tab="login">
      <span class="t-label text-muted m-center">MEMBERS ONLY</span>
      <h1 class="m-0 t-title-tight font-normal text-center portal-h">TL ALUMNI NETWORK PORTAL</h1>

      <div class="portal-tabs t-label" role="tablist" aria-label="Sign in or sign up">
        <button type="button" role="tab" class="portal-tab" data-tab="login" aria-selected="true">LOG IN</button>
        <button type="button" role="tab" class="portal-tab" data-tab="signup" aria-selected="false">SIGN UP</button>
      </div>

      <input id="portal-email" type="email" name="email" autocomplete="email" placeholder="you@usc.edu" aria-label="Email" class="t-caption portal-input only-login" required />
      <input id="portal-password" type="password" name="password" autocomplete="current-password" placeholder="Password" aria-label="Password" class="t-caption portal-input only-login" minlength="8" />

      <button type="submit" class="portal-btn t-title whitespace-nowrap only-login">LOG IN</button>
      <button type="button" id="portal-magic" class="portal-link t-label only-login">FORGOT PASSWORD? EMAIL A MAGIC LINK</button>

      <!-- Sign up is deliberately inert (Bryan, 2026-09-14): no input, no button, nothing wired. Alumni join by invitation. -->
      <p class="m-0 t-caption text-center only-signup portal-signup-note">Sign up is by invitation. TroyLabs alumni will receive an email with their link.</p>
      <p class="m-0 t-fine text-muted text-center only-signup portal-hint">Think you should have access? Email troylabs@usc.edu.</p>

      <p id="portal-msg" class="m-0 t-fine text-center portal-msg" role="status"></p>
      <p class="m-0 t-fine text-muted text-center portal-hint">Access is limited to TroyLabs alumni.</p>
    </form>
  </PortalFrame>
</BaseLayout>
<script src="../../scripts/portal-ui.ts"></script>


<script is:inline>
  (() => {
    const form = document.getElementById('portal-auth');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = '1';
    const msg = document.getElementById('portal-msg');
    const pw = document.getElementById('portal-password');
    for (const tab of form.querySelectorAll('.portal-tab')) {
      tab.addEventListener('click', () => {
        const t = tab.dataset.tab;
        form.dataset.tab = t;
        for (const b of form.querySelectorAll('.portal-tab')) b.setAttribute('aria-selected', String(b === tab));
        pw.required = t === 'login';
        document.getElementById('portal-email').required = t === 'login';
        msg.textContent = '';
      });
    }
    pw.required = true;
    // Auth is wired to the site's own database once it exists. Until then, say so — never fake a login.
    const notYet = () => { msg.textContent = 'Sign-in opens when the alumni database goes live. Check back soon.'; };
    form.addEventListener('submit', (e) => { e.preventDefault(); notYet(); });
    document.getElementById('portal-magic')?.addEventListener('click', notYet);
  })();
</script>
