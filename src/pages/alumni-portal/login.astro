---
/**
 * TL Alumni Network Portal — sign in. Log in with email + password, or Sign up for a one-time magic link
 * (then set a password). Mirrors the MVP's auth flow; wired to the site's own Supabase project once it exists
 * (until then the form explains that, honestly, instead of pretending).
 * Inputs echo the pill CTA: 0.3 du inner stroke, inner white glow (PillButton.astro).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortalFrame from '../../components/portal/PortalFrame.astro';
---

<BaseLayout title="Sign in — TL Alumni Network Portal" description="Sign in to the TroyLabs alumni network.">
  <PortalFrame h={600} label="Sign in to the alumni portal">
    <form id="portal-auth" class="portal-form flex flex-col items-center" novalidate data-tab="login">
      <span class="t-label text-muted m-center">MEMBERS ONLY</span>
      <h1 class="m-0 t-title-tight font-normal text-center portal-h">TL ALUMNI NETWORK PORTAL</h1>

      <div class="portal-tabs t-label" role="tablist" aria-label="Sign in or sign up">
        <button type="button" role="tab" class="portal-tab" data-tab="login" aria-selected="true">LOG IN</button>
        <button type="button" role="tab" class="portal-tab" data-tab="signup" aria-selected="false">SIGN UP</button>
      </div>

      <input id="portal-email" type="email" name="email" autocomplete="email" placeholder="you@usc.edu" aria-label="Email" class="t-caption portal-input" required />
      <input id="portal-password" type="password" name="password" autocomplete="current-password" placeholder="Password" aria-label="Password" class="t-caption portal-input only-login" minlength="8" />

      <button type="submit" class="portal-btn t-title whitespace-nowrap"><span class="only-login">LOG IN</span><span class="only-signup">EMAIL ME A MAGIC LINK</span></button>

      <button type="button" id="portal-magic" class="portal-link t-label only-login">FORGOT PASSWORD? EMAIL A MAGIC LINK</button>
      <p class="m-0 t-fine text-muted text-center only-signup portal-hint">New alumni get a one-time magic link, then create a password for future logins.</p>

      <p id="portal-msg" class="m-0 t-fine text-center portal-msg" role="status"></p>
      <p class="m-0 t-fine text-muted text-center portal-hint">Access is limited to TroyLabs alumni.</p>
    </form>
  </PortalFrame>
</BaseLayout>

<style is:global>
  .portal-form { width: calc(400 * var(--u)); }
  .portal-h { margin-top: calc(18 * var(--u)); }
  .portal-tabs { display: flex; width: calc(320 * var(--u)); margin-top: calc(34 * var(--u)); border-bottom: 1px solid rgb(255 255 255 / 0.15); }
  .portal-tab { flex: 1; background: none; border: 0; color: var(--color-muted); padding: 0 0 calc(10 * var(--u)); cursor: pointer; font: inherit; letter-spacing: inherit; transition: color 150ms ease; margin-bottom: -1px; border-bottom: 1px solid transparent; }
  .portal-tab:hover { color: var(--color-ink); }
  .portal-tab[aria-selected="true"] { color: var(--color-ink); border-bottom-color: var(--color-orange); }
  .portal-input {
    appearance: none; border: 0; outline: none; background: transparent; color: var(--color-ink);
    width: calc(320 * var(--u)); height: calc(40 * var(--u)); margin-top: calc(18 * var(--u)); padding-left: calc(18 * var(--u));
    border-radius: 9999px;
    box-shadow: inset 0 0 0 calc(0.3 * var(--u)) rgb(255 255 255 / 0.5), inset 0 0 calc(13.6 * var(--u)) rgb(255 255 255 / 0.12);
    transition: box-shadow 150ms ease;
  }
  .portal-input::placeholder { color: var(--color-muted); }
  .portal-input:focus { box-shadow: inset 0 0 0 calc(0.3 * var(--u)) #fff, inset 0 0 calc(13.6 * var(--u)) rgb(255 255 255 / 0.3); }
  .portal-btn {
    border: 0; cursor: pointer; background: transparent; color: var(--color-ink); border-radius: 9999px;
    min-width: calc(120 * var(--u)); height: calc(33.6 * var(--u)); padding: 0 calc(24 * var(--u)); margin-top: calc(22 * var(--u));
    box-shadow: inset 0 0 0 calc(0.3 * var(--u)) #fff, inset 0 0 calc(13.6 * var(--u)) rgb(255 255 255 / 0.4);
    transition: box-shadow 150ms ease;
  }
  .portal-btn:hover, .portal-btn:focus-visible { box-shadow: inset 0 0 0 calc(0.3 * var(--u)) #fff, inset 0 0 calc(13.6 * var(--u)) rgb(255 255 255 / 0.6); }
  .portal-link { background: none; border: 0; color: var(--color-muted); cursor: pointer; margin-top: calc(18 * var(--u)); font: inherit; letter-spacing: inherit; transition: color 150ms ease; }
  .portal-link:hover { color: var(--color-ink); }
  .portal-hint { margin-top: calc(14 * var(--u)); max-width: calc(320 * var(--u)); }
  .portal-msg { color: var(--color-orange); margin-top: calc(18 * var(--u)); min-height: calc(10 * var(--u)); max-width: calc(320 * var(--u)); }
  /* the two tabs share one form; the inactive tab's controls are simply not there */
  .portal-form[data-tab="login"] .only-signup, .portal-form[data-tab="signup"] .only-login { display: none; }
  #portal-auth.denied .portal-input { animation: gate-shake 400ms ease; }
  @keyframes gate-shake {
    0%, 100% { transform: translateX(0); } 20% { transform: translateX(calc(-7 * var(--u))); }
    45% { transform: translateX(calc(6 * var(--u))); } 70% { transform: translateX(calc(-3.5 * var(--u))); } 90% { transform: translateX(calc(1.5 * var(--u))); }
  }
  @media (max-width: 767px) {
    .portal-form { width: 100%; max-width: 340px; }
    .portal-h { margin-top: 10px; }
    .portal-tabs { width: 100%; margin-top: 26px; }
    .portal-tab { padding-bottom: 10px; }
    .portal-input { width: 100%; height: 44px; margin-top: 14px; padding-left: 18px; font-size: 14px; }
    .portal-btn { height: 44px; padding: 0 26px; margin-top: 18px; }
    .portal-link { margin-top: 16px; }
    .portal-hint, .portal-msg { max-width: 100%; margin-top: 12px; }
  }
</style>

<script is:inline>
  (() => {
    const form = document.getElementById('portal-auth');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = '1';
    const msg = document.getElementById('portal-msg');
    const pw = document.getElementById('portal-password');
    for (const tab of form.querySelectorAll('.portal-tab')) {
      tab.addEventListener('click', () => {
        const t = tab.dataset.tab;
        form.dataset.tab = t;
        for (const b of form.querySelectorAll('.portal-tab')) b.setAttribute('aria-selected', String(b === tab));
        pw.required = t === 'login';
        msg.textContent = '';
      });
    }
    pw.required = true;
    // Auth is wired to the site's own database once it exists. Until then, say so — never fake a login.
    const notYet = () => { msg.textContent = 'Sign-in opens when the alumni database goes live. Check back soon.'; };
    form.addEventListener('submit', (e) => { e.preventDefault(); notYet(); });
    document.getElementById('portal-magic')?.addEventListener('click', notYet);
  })();
</script>
