---
/**
 * Alumni portal › Your profile. Every section and field of the MVP's form, in the site's language.
 * Filled from and saved to your row in the database by scripts/portal-profile.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/portal.css';
import PortalShell from '../../components/portal/PortalShell.astro';
import { DIVISIONS, EBOARD_ROLES, INDUSTRIES } from '../../lib/portal/options';
const ON = { divisions: [] as string[], industries: [] as string[] };
---

<BaseLayout nav="portal" current="profile" title="Your profile — TL Alumni Network Portal" description="Your TroyLabs alumni profile.">
  <PortalShell label="Your profile">
    <div class="portal-page-head">
      <div class="portal-member-head" style="margin-top:0">
        <label class="portal-photo" for="pf-photo" title="Change photo">
          <span class="portal-avatar is-large t-sub" aria-hidden="true" id="pf-initials"></span>
          <img id="pf-photo-preview" alt="" hidden />
          <span class="portal-photo-edit t-fine">CHANGE</span>
          <input id="pf-photo" type="file" accept="image/*" hidden />
        </label>
        <div>
          <h1 class="t-title portal-page-title">YOUR PROFILE</h1>
          <p class="t-caption text-muted portal-page-sub"><span id="pf-head-name"></span> <span class="t-fine portal-role" id="pf-head-role" hidden>ADMIN</span></p>
          <p class="t-fine text-muted" style="margin:calc(8 * var(--u)) 0 0">Your photo shows on your card in search, on your member page and on the globe.</p>
        </div>
      </div>
    </div>

    <!-- sign-up (Bryan, 2026-09-30): until an admin approves them, this panel tells a new member what
         leadership needs to recognise them and where they stand. Filled by scripts/portal-profile.ts. -->
    <section class="portal-panel portal-onboard" id="pf-onboard" hidden aria-live="polite">
      <span class="t-fine portal-role" data-onboard-chip>WAITING FOR APPROVAL</span>
      <h2 class="t-sub portal-onboard-title" data-onboard-title>Create your profile</h2>
      <p class="m-0 t-caption text-muted" data-onboard-text></p>
      <p class="m-0 t-caption portal-onboard-missing" data-onboard-missing></p>
      <div class="portal-field is-full portal-onboard-note" data-onboard-note>
        <label class="t-label text-muted" for="pf-note">HOW WERE YOU PART OF TROYLABS?</label>
        <textarea id="pf-note" class="t-caption portal-textarea" maxlength="500" data-optional placeholder="e.g. Tech division, Fall 2022 to Spring 2024; built the BUILD demo-day site."></textarea><p class="portal-help t-fine text-muted">Optional. Helps leadership recognise you.</p>
      </div>
    </section>

    <div class="portal-panel" id="pf-completion" style="margin-top:calc(22 * var(--u))">
      <div class="flex justify-between items-baseline">
        <span class="t-label text-muted">PROFILE COMPLETION</span>
        <span class="t-label" style="color:var(--color-orange)" data-completion>—</span>
      </div>
      <div class="portal-progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"><i style="width:0%"></i></div>
      <p class="m-0 t-fine text-muted" style="margin-top:calc(10 * var(--u))" data-completion-note>Updates live as you fill fields — save when you're done.</p>
    </div>

    <!-- inert + SAVE disabled until the saved profile is in: typing before it loaded used to be overwritten by it -->
    <form class="portal-profile" novalidate inert aria-busy="true">
      <h2 class="t-sub portal-section-h">Contact details</h2>
      <p class="portal-section-sub t-fine text-muted">Keep a personal email on file so members can reach you after graduation. Each row saves on its own. A new address gets a confirmation email first; once confirmed, you can sign in with it too.</p>
      <div class="portal-form-grid portal-contact">
        <div class="portal-field portal-contact-row" data-contact="usc">
          <label class="t-label text-muted" for="pf-usc">USC EMAIL</label>
          <div class="portal-inline"><input id="pf-usc" type="email" class="t-caption portal-input" placeholder="you@usc.edu" autocomplete="email" data-optional /><button type="button" class="portal-btn is-small t-label portal-save-row" data-action="save-row" data-done="SAVED" disabled>SAVE</button></div><p class="portal-help t-fine text-muted">Optional if you signed up with another email. Helps leadership recognise you.</p>
          <p class="t-fine portal-feedback" role="status"></p>
        </div>
        <div class="portal-field portal-contact-row" data-contact="personal">
          <label class="t-label text-muted" for="pf-personal">PERSONAL EMAIL <span class="portal-req" title="Required">REQUIRED</span></label>
          <div class="portal-inline"><input id="pf-personal" type="email" class="t-caption portal-input" data-label="personal email" placeholder="you@gmail.com" autocomplete="email" /><button type="button" class="portal-btn is-small t-label portal-save-row" data-action="save-row" data-done="SAVED" disabled>SAVE</button></div><p class="portal-help t-fine text-muted">How members reach you after graduation (your USC email stops working). A new address gets a confirmation email first.</p>
          <p class="t-fine portal-feedback" role="status"></p>
        </div>
        <div class="portal-field is-full">
          <label class="portal-check t-caption"><input id="pf-email-opt" type="checkbox" checked /><i></i>Email me TroyLabs announcements</label>
          <p class="t-fine portal-feedback" id="pf-email-opt-fb"></p>
        </div>
        <div class="portal-field portal-contact-row" data-contact="phone">
          <label class="t-label text-muted" for="pf-phone">PHONE <span class="portal-req" title="Required">REQUIRED</span></label>
          <div class="portal-inline"><input id="pf-phone" type="tel" class="t-caption portal-input" placeholder="e.g. +1 213 555 0123" inputmode="tel" autocomplete="tel" data-optional /><button type="button" class="portal-btn is-small t-label portal-save-row" data-action="save-row" data-done="SAVED" disabled>SAVE</button></div><p class="portal-help t-fine text-muted">How members reach you. TroyLabs only texts you if you turn that on below.</p>
          <label class="portal-check t-caption"><input id="pf-phone-opt" type="checkbox" /><i></i>Text me TroyLabs event invitations</label>
          <p class="portal-help t-fine text-muted">A few texts a month at most. Message and data rates may apply. Reply STOP to any text to stop, HELP for help.</p>
          <p class="t-fine portal-feedback" role="status"></p>
        </div>
      </div>

      <h2 class="t-sub portal-section-h">Status <span class="portal-req" title="Required">REQUIRED</span></h2>
      <div class="flex flex-wrap portal-chips" data-field="status" data-label="status" data-single>
        <button type="button" class="t-fine portal-chip" aria-pressed="false" data-value="student">CURRENT STUDENT</button>
        <button type="button" class="t-fine portal-chip" aria-pressed="false" data-value="alum">ALUM</button>
      </div>
      <!-- the year fields read like every other field: label (with its hint) on one line, the control full width under it -->
      <div id="pf-grad" class="portal-field portal-year-field" hidden>
        <label class="t-label text-muted" for="pf-grad-year">EXPECTED GRADUATION <span class="portal-req" title="Required">REQUIRED</span></label>
        <div class="portal-inline portal-term">
          <select id="pf-grad-term" class="t-caption portal-input portal-select" aria-label="Graduation semester"><option>Spring</option><option>Fall</option></select>
          <input id="pf-grad-year" class="t-caption portal-input" inputmode="numeric" placeholder="Year" aria-label="Graduation year" />
        </div>
        <p id="pf-grad-note" class="portal-help t-fine text-muted">The semester you finish at USC. When that semester ends you become an alum automatically: your profile shows your class year, and you appear in the alumni channels for your division.</p>
      </div>
      <div id="pf-classof" class="portal-field portal-year-field">
        <label class="t-label text-muted" for="pf-classof-year">CLASS OF <span class="portal-req" title="Required">REQUIRED</span></label>
        <input id="pf-classof-year" class="t-caption portal-input is-wide" inputmode="numeric" placeholder="e.g. 2025" aria-label="Graduation year" data-label="class year" /><p class="portal-help t-fine text-muted">The year you graduated from USC.</p>
      </div>

      <h2 class="t-sub portal-section-h">Basic info</h2>
      <div class="portal-form-grid">
        <div class="portal-field"><label class="t-label text-muted" for="pf-name">FULL NAME <span class="portal-req" title="Required">REQUIRED</span></label><input id="pf-name" data-label="name" class="t-caption portal-input is-wide" placeholder="Your name" /></div>
        <div class="portal-field"><label class="t-label text-muted" for="pf-year">SEMESTER YOU JOINED TROYLABS <span class="portal-req" title="Required">REQUIRED</span></label>
          <div class="portal-inline portal-term">
            <select id="pf-term" class="t-caption portal-input portal-select" aria-label="Semester"><option>Fall</option><option>Spring</option></select>
            <input id="pf-year" data-label="semester you joined" class="t-caption portal-input" inputmode="numeric" placeholder="Year" aria-label="Year" />
          </div>
        </div>
        <div class="portal-field is-full"><label class="t-label text-muted" for="pf-li">LINKEDIN PROFILE <span class="portal-req" title="Required">REQUIRED</span></label><input id="pf-li" inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" aria-required="true" data-label="LinkedIn" class="t-caption portal-input is-wide" placeholder="https://www.linkedin.com/in/your-profile" /><p class="portal-help t-fine text-muted">Your exact profile link: on LinkedIn, open your profile and copy the address (linkedin.com/in/…).</p></div>
        <div class="portal-field is-full"><label class="t-label text-muted" for="pf-bio">BIO</label><textarea id="pf-bio" data-label="bio" class="t-caption portal-textarea" placeholder="A line or two about what you do and what you're into."></textarea></div>
      </div>

      <!-- LinkedIn import (2026-10-05): work history, honors, publications… from the link above, after approval -->
      <h2 class="t-sub portal-section-h">Work history from LinkedIn</h2>
      <p class="portal-section-sub t-fine text-muted">Your jobs, honors and publications come from the LinkedIn link above (your profile must be public). The first import starts when leadership approves you; after that, sync whenever your LinkedIn changes, once a day. A photo you upload here is never replaced.</p>
      <div class="portal-panel" id="pf-linkedin">
        <div class="portal-li-status"><p class="m-0 t-caption" data-li-status role="status">Loading…</p><button type="button" class="portal-btn is-small t-label" data-li-sync hidden>SYNC NOW</button></div>
        <p class="m-0 t-fine portal-feedback" data-li-fb role="status"></p>
      </div>
      <div data-li-preview></div>

      <h2 class="t-sub portal-section-h">E-Board history</h2>
      <!-- read-only: a role is a credential, so only admins set it (Bryan, 2026-09-14: "not everyone who signs up was e-board").
           Admins edit roles from Admin › Users. Design preview: one placeholder role. -->
      <div class="flex flex-wrap portal-chips portal-chips-static" id="pf-eboard">
        <span class="t-fine text-muted" id="pf-eboard-none">None on record.</span>
      </div>
      <p class="portal-help t-fine text-muted" id="pf-eboard-help">Served on e-board and don't see it here? Email troylabs@usc.edu and leadership will add it.</p>
      <!-- while they wait (2026-10-02): applicants list the roles they held; leadership sees them in the approval list and
           approving makes them their record. Hidden once approved (then it's leadership's to edit). -->
      <div id="pf-claim" data-roles hidden style="margin-top:calc(12 * var(--u))">
        <p class="m-0 t-label text-muted portal-field-label">WERE YOU ON E-BOARD?</p>
        <p class="portal-help t-fine text-muted">Optional. Pick each role, then the semester(s). Leadership confirms it when they approve you.</p>
        <div class="flex flex-wrap portal-chips" data-field="eboard" data-optional style="margin-top:calc(8 * var(--u))">{EBOARD_ROLES.map((c) => <button type="button" class="t-fine portal-chip" aria-pressed="false">{c}</button>)}</div>
        <div class="portal-role-years"></div>
      </div>

      <h2 class="t-sub portal-section-h">Divisions <span class="portal-req" title="Required">REQUIRED</span></h2>
      <div class="flex flex-wrap portal-chips" data-field="divisions" data-label="divisions">{DIVISIONS.map((c) => <button type="button" class="t-fine portal-chip" aria-pressed={ON.divisions.includes(c) ? 'true' : 'false'}>{c}</button>)}</div>

      <h2 class="t-sub portal-section-h">TL BUILD startups</h2>
      <p class="portal-section-sub t-fine text-muted">If you were in BUILD, the startups you built.</p>
      <div id="pf-startups" class="flex flex-wrap portal-chips" data-tags data-optional style="margin-bottom:calc(12 * var(--u))"></div>
      <div class="portal-inline" data-adds="#pf-startups"><input class="t-caption portal-input" placeholder="Add startup…" aria-label="Add startup" /><button type="button" class="portal-btn is-small t-label">ADD</button></div>

      <h2 class="t-sub portal-section-h">Industries of interest</h2>
      <div class="flex flex-wrap portal-chips" data-field="industries" data-label="industries" style="margin-bottom:calc(12 * var(--u))">{INDUSTRIES.map((c) => <button type="button" class="t-fine portal-chip" aria-pressed={ON.industries.includes(c) ? 'true' : 'false'}>{c}</button>)}</div>
      <div id="pf-industries-extra" class="flex flex-wrap portal-chips" data-tags data-optional style="margin-bottom:calc(12 * var(--u))"></div>
      <div class="portal-inline" data-adds="#pf-industries-extra"><input class="t-caption portal-input" placeholder="Type an industry and press Add" aria-label="Add industry" /><button type="button" class="portal-btn is-small t-label">ADD</button></div>

      <h2 class="t-sub portal-section-h">Location <span class="portal-req" title="Required">REQUIRED</span></h2>
      <p class="portal-section-sub t-fine text-muted">The city you live in right now: where you study, work, or are based. Update it when you move.</p>
      <div class="portal-inline"><input id="pf-loc" class="t-caption portal-input" placeholder="City, State" aria-label="Location" data-label="location" /><button type="button" class="portal-btn is-small t-label" data-action="update" data-done="UPDATED">UPDATE</button></div>
      <p class="t-fine portal-feedback" role="status"></p>
      <p class="portal-help t-fine text-muted" id="pf-loc-note">No pin on the globe yet.</p>


      <div class="portal-save"><button type="submit" class="portal-btn t-title" data-action="save" data-done="SAVED" disabled>SAVE</button><p class="t-fine portal-feedback" role="status"></p></div>
    </form>
  </PortalShell>
</BaseLayout>
<script src="../../scripts/portal-profile.ts"></script>
