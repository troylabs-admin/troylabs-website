---
/**
 * BUILD — Figma frame 6977:9 (1001×5463 du). Nav 0–79 · sections 79–4000 · Footer (256 du) ·
 * 23 du of empty frame below the footer, reproduced with a page-scoped footer margin.
 * DEVIATION (Bryan, 2026-08-23): the "previous startups" section (heading + 1184 du placeholder band,
 * still a "tbd" panel in Figma) is removed entirely — page height 4279 vs the frame's 5463
 * (tests/fidelity HEIGHT_OVERRIDES.build).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/build/Hero.astro';
import Timeline from '../components/sections/build/Timeline.astro';
import Gallery from '../components/sections/build/Gallery.astro';
import Stats from '../components/sections/build/Stats.astro';
import Backers from '../components/sections/build/Backers.astro';
---

<BaseLayout title="BUILD — TroyLabs' 8-week startup accelerator" description="BUILD is TroyLabs' 8-week flagship accelerator providing hands-on consulting to USC's premier startups." current="build">
  <Hero />
  <Timeline />
  <Gallery />
  <Stats />
  <Backers />
</BaseLayout>

<style is:global>
  /* Figma BUILD frame: 23 du of bare background below the Footer instance (5440 → 5463). */
  footer[data-figma="Footer"] { margin-bottom: calc(23 * var(--u)); }
</style>
