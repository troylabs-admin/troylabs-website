---
/**
 * DESIGN LAB — five candidates for the Home "50 ACTIVE MEMBERS" block (replacing the starburst).
 * Not linked from the nav; visit /lab/members. Each panel is 500×420 du at the section's dark ground.
 * Once one is chosen it gets built properly into sections/home/Catalyst.astro and this page can be deleted.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import rocket from '../../assets/figma/wordmark-rocket-flat.svg?raw';
import navRocket from '../../assets/figma/nav-rocket.svg?raw';

/* deterministic pseudo-random (seeded) so every render matches */
function rng(seed: number) { let a = seed; return () => { a |= 0; a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }

/* 1 · orbital cluster: 50 dots on 4 elliptical rings around a core */
const r1 = rng(11);
const ORBITS = [ { rx: 60, ry: 22, n: 8, dur: 26 }, { rx: 95, ry: 36, n: 12, dur: 38 }, { rx: 130, ry: 50, n: 14, dur: 52 }, { rx: 165, ry: 64, n: 16, dur: 70 } ];
const orbitDots = ORBITS.flatMap((o, oi) => Array.from({ length: o.n }, (_, i) => ({ oi, ...o, phase: i / o.n + r1() * 0.02, s: 2 + r1() * 1.6 })));  // phase as a unitless fraction of the loop

/* 2 · star cluster: gaussian clump of 50 */
const r2 = rng(23);
const gauss = () => (r2() + r2() + r2() - 1.5) / 1.5;
const cluster = Array.from({ length: 50 }, () => ({ x: gauss() * 120, y: gauss() * 80, s: 1.6 + r2() * 2.6, d: r2() * 6, dur: 2.5 + r2() * 3 }));

/* 3 · exhaust plume: 50 dots streaming from an ascending rocket */
const r3 = rng(37);
const plume = Array.from({ length: 50 }, (_, i) => ({ x: (r3() - 0.5) * 26, delay: r3() * 4, dur: 2.2 + r3() * 2.4, drift: (r3() - 0.5) * 60, s: 1.8 + r3() * 2 }));

/* 4 · helmet formation: 50 dots along the mark's outline (sampled client-side from the nav rocket path) */

/* 5 · counter swarm: dots forming "50" (sampled client-side from canvas text) */
---

<BaseLayout title="Members lab" description="Design candidates for 50 active members">
  <div class="lab t-body">
    <h1 class="t-title" style="margin:24px 0 6px">"50 ACTIVE MEMBERS" — five candidates</h1>
    <p style="opacity:.7;margin:0 0 30px">Pick one; it gets built into the Catalyst section. Everything here is seeded/deterministic.</p>

    <div class="grid">
      <figure>
        <div class="panel" id="v1">
          <span class="core"></span>
          {orbitDots.map((d) => (
            <span class="orb-tilt">
              <span class="orb-wrap" style={`--dur:${d.dur}s;animation-delay:calc(${d.phase} * var(--dur) * -1)`}>
                <span class="orb-dot" style={`width:${d.s}px;height:${d.s}px;transform:translateX(${d.rx}px)`} />
              </span>
            </span>
          ))}
        </div>
        <figcaption>1 · Orbital cluster — 50 members orbiting one mission (structure, matches the planet language)</figcaption>
      </figure>

      <figure>
        <div class="panel" id="v2">
          {cluster.map((d) => <span class="cl-dot" style={`left:calc(50% + ${d.x}px);top:calc(50% + ${d.y}px);width:${d.s}px;height:${d.s}px;animation-delay:-${d.d}s;animation-duration:${d.dur}s`} />)}
        </div>
        <figcaption>2 · Star cluster — the crowd as a breathing open cluster (warmth, pairs with the constellation)</figcaption>
      </figure>

      <figure>
        <div class="panel" id="v3">
          <div class="ex-rocket" set:html={rocket} />
          {plume.map((d) => <span class="ex-dot" style={`left:calc(50% + ${d.x}px);--drift:${d.drift}px;width:${d.s}px;height:${d.s}px;animation-delay:-${d.delay}s;animation-duration:${d.dur}s`} />)}
        </div>
        <figcaption>3 · Exhaust — the members are the thrust behind the rocket</figcaption>
      </figure>

      <figure>
        <div class="panel" id="v4"><div class="helmet-src" set:html={navRocket} /></div>
        <figcaption>4 · Formation — 50 dots holding the TroyLabs mark's outline</figcaption>
      </figure>

      <figure>
        <div class="panel" id="v5"></div>
        <figcaption>5 · Counter swarm — the "50" numeral made of the 50 (hover: scatter & reform)</figcaption>
      </figure>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .lab { width: min(1200px, 92vw); margin: 0 auto; padding-bottom: 80px; }
  .lab .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .lab figure { margin: 0; }
  .lab figcaption { opacity: 0.75; margin-top: 10px; font-size: 14px; }
  .lab .panel { position: relative; width: 100%; height: 420px; background: #0d0c0b; border: 1px solid rgb(255 255 255 / 0.08); border-radius: 12px; overflow: hidden; }

  /* v1 orbital */
  #v1 .core { position: absolute; left: 50%; top: 50%; width: 14px; height: 14px; margin: -7px; border-radius: 999px; background: #fff; box-shadow: 0 0 24px 6px rgb(255 125 44 / 0.5); }
  #v1 .orb-tilt { position: absolute; left: 50%; top: 50%; transform: scaleY(0.38) rotate(-8deg); }
  #v1 .orb-wrap { position: absolute; animation: v1spin var(--dur) linear infinite; }
  #v1 .orb-dot { position: absolute; border-radius: 999px; background: #fff; opacity: 0.9; }
  @keyframes v1spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

  /* v2 cluster */
  #v2 .cl-dot { position: absolute; border-radius: 999px; background: #fff; animation: v2tw ease-in-out infinite alternate; }
  @keyframes v2tw { from { opacity: 0.25; transform: scale(0.9); } to { opacity: 1; transform: scale(1.15); } }

  /* v3 exhaust */
  #v3 .ex-rocket { position: absolute; left: 50%; top: 24%; width: 120px; height: 129px; transform: translateX(-50%); }
  #v3 .ex-rocket svg { width: 100%; height: 100%; }
  #v3 .ex-dot { position: absolute; top: 46%; border-radius: 999px; background: #fff; animation: v3fall linear infinite; }
  @keyframes v3fall { 0% { transform: translate(0, 0); opacity: 1; } 100% { transform: translate(var(--drift), 180px); opacity: 0; } }

  /* v4/v5 dots are placed by the script */
  .lab .jsdot { position: absolute; border-radius: 999px; background: #fff; transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1); }
  #v4 .helmet-src { display: none; }
</style>

<script>
  // v4: 50 dots along the nav-rocket outline
  const v4 = document.querySelector('#v4')!;
  const path4 = v4.querySelector('path')!;
  const L4 = (path4 as unknown as SVGPathElement).getTotalLength();
  for (let i = 0; i < 50; i++) {
    const pt = (path4 as unknown as SVGPathElement).getPointAtLength((i / 50) * L4);
    const d = document.createElement('span');
    d.className = 'jsdot';
    const s = 2 + (i % 3);
    d.style.cssText = `left:${pt.x * 9 + v4.clientWidth / 2 - 117}px;top:${pt.y * 9 + 34}px;width:${s}px;height:${s}px;opacity:.9`;
    v4.appendChild(d);
  }
  // v5: dots forming "50", scatter on hover
  const v5 = document.querySelector('#v5') as HTMLElement;
  const cv = document.createElement('canvas'); cv.width = 300; cv.height = 160;
  const cx = cv.getContext('2d')!;
  cx.font = '900 150px Helvetica'; cx.textAlign = 'center'; cx.textBaseline = 'middle'; cx.fillText('50', 150, 85);
  const img = cx.getImageData(0, 0, 300, 160).data;
  const pts: [number, number][] = [];
  for (let tries = 0; tries < 4000 && pts.length < 50; tries++) {
    const x = Math.floor(Math.random() * 300), y = Math.floor(Math.random() * 160);
    if (img[(y * 300 + x) * 4 + 3] > 128 && pts.every(([px, py]) => Math.hypot(px - x, py - y) > 13)) pts.push([x, y]);
  }
  const dots5 = pts.map(([x, y]) => {
    const d = document.createElement('span'); d.className = 'jsdot';
    const s = 3 + Math.random() * 2;
    d.style.cssText = `left:${x + v5.clientWidth / 2 - 150}px;top:${y + 130}px;width:${s}px;height:${s}px`;
    v5.appendChild(d); return d;
  });
  v5.addEventListener('pointerenter', () => dots5.forEach((d) => { d.style.transform = `translate(${(Math.random() - 0.5) * 260}px, ${(Math.random() - 0.5) * 200}px)`; }));
  v5.addEventListener('pointerleave', () => dots5.forEach((d) => { d.style.transform = 'none'; }));
</script>
